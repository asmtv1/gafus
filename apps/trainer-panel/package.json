    "@gafus/core": "workspace:*",
    "@gafus/prisma": "workspace:*",
    "@gafus/types": "workspace:*",
    "@gafus/ui-components": "workspace:*",
    "hls.js": "1.6.15",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "20.4.8",
    "@types/react": "19.1.9",
    "@types/react-dom": "19.1.7",
    "eslint": "9.32.0",
    "jsdom": "26.1.0",
    "typescript": "5.8.3",
