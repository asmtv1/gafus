{
  "name": "@gafus/trainer-panel",
  "version": "1.7.0",
  "private": true,
  "scripts": {
    "build": "vite build --config src/trainer-vite/live/vite.config.mjs",
    "dev": "vite --config src/trainer-vite/live/vite.config.mjs",
    "start": "vite preview --config src/trainer-vite/live/vite.config.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.vite.json",
    "lint": "eslint src/trainer-vite",
    "test": "vitest run src/trainer-vite --maxWorkers=1"
  },
  "dependencies": {
    "@gafus/core": "workspace:*",
    "@gafus/types": "workspace:*",
    "@gafus/consultation-shared": "workspace:*",
    "@gafus/ui-components": "workspace:*",
    "@gafus/prisma": "workspace:*",
    "zod": "^3.24.1",
    "react": "19.2.1",
    "react-dom": "19.2.1"
  },
  "devDependencies": {
    "vite": "8.0.10",
    "vitest": "4.0.18",
    "typescript": "5.8.3",
    "@types/node": "20.4.8",
    "@types/react": "19.1.9",
    "@types/react-dom": "19.1.7",
    "eslint": "9.32.0",
    "jsdom": "26.1.0"
  }
}
