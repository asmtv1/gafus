{
  "name": "@gafus/trainer-panel",
  "version": "1.7.3",
  "private": true,
  "scripts": {
    "build": "vite build --config src/trainer-vite/live/vite.config.mjs",
    "dev": "vite --config src/trainer-vite/live/vite.config.mjs",
    "start": "vite preview --config src/trainer-vite/live/vite.config.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.vite.json",
