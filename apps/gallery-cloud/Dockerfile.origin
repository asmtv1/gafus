FROM node:22-bookworm-slim AS build
WORKDIR /app
RUN npm install --ignore-scripts --no-save esbuild@0.27.2 @aws-sdk/client-s3@3.980.0
COPY apps/gallery-cloud/src apps/gallery-cloud/src
COPY packages/gallery-storage/src packages/gallery-storage/src
COPY packages/core/src/services/gallery packages/core/src/services/gallery
RUN ./node_modules/.bin/esbuild apps/gallery-cloud/src/origin-service.ts --bundle --platform=node --target=node22 --format=esm --alias:@gafus/gallery-storage=./packages/gallery-storage/src --alias:@gafus/core/services/gallery/imageProcessing=./packages/core/src/services/gallery/imageProcessing.ts --outfile=origin.mjs '--banner:js=import { createRequire } from "node:module"; const require = createRequire(import.meta.url);'
FROM node:22-bookworm-slim
WORKDIR /app
COPY --from=build /app/origin.mjs ./origin.mjs
USER node
ENV PORT=8080
EXPOSE 8080
CMD ["node", "origin.mjs"]
