# Dedicated Questions-only Photo V2 Container Job (1 vCPU / 2GiB, timeout 240 s).
# No FFmpeg, MP4, HLS or video libraries. Reuses one existing Questions Job.
# Build context must be GAFUS Refactor repository root.
FROM node:22-bookworm-slim AS build
WORKDIR /app
RUN npm install --ignore-scripts --no-save esbuild@0.27.2 sharp@0.35.5 @aws-sdk/client-s3@3.980.0 @aws-sdk/s3-presigned-post@3.980.0 @aws-sdk/s3-request-presigner@3.980.0
COPY apps/feed-cloud/src apps/feed-cloud/src
COPY packages/feed-cloud/src packages/feed-cloud/src
COPY packages/cdn-upload/src packages/cdn-upload/src
RUN ./node_modules/.bin/esbuild apps/feed-cloud/src/questions-v2-job-entry.ts \
  --bundle --platform=node --target=node22 --format=esm \
  --external:sharp \
  --alias:@gafus/feed-cloud=./packages/feed-cloud/src/questions-v2.ts \
  --alias:@gafus/cdn-upload=./packages/cdn-upload/src/questionsV2Media.ts \
  --outfile=questions-photo.mjs \
  '--banner:js=import { createRequire } from "node:module"; const require=createRequire(import.meta.url);'

FROM node:22-bookworm-slim AS photo
WORKDIR /app
RUN npm install --omit=dev --ignore-scripts --no-save sharp@0.35.5 @aws-sdk/client-s3@3.980.0
COPY --from=build /app/questions-photo.mjs /app/questions-photo.mjs
USER node
CMD ["node","/app/questions-photo.mjs"]
