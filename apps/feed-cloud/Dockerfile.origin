FROM node:22-bookworm-slim AS build
WORKDIR /app
RUN npm install --ignore-scripts --no-save esbuild@0.27.2 @aws-sdk/client-s3@3.980.0 @aws-sdk/s3-request-presigner@3.980.0 @aws-sdk/s3-presigned-post@3.980.0
COPY apps/feed-cloud/src apps/feed-cloud/src
COPY packages/feed-storage/src packages/feed-storage/src
RUN ./node_modules/.bin/esbuild apps/feed-cloud/src/origin-service.ts --bundle --platform=node --target=node22 --format=esm --alias:@gafus/feed-storage=./packages/feed-storage/src/index.ts --outfile=origin.mjs '--banner:js=import { createRequire } from "node:module"; const require = createRequire(import.meta.url);'
FROM node:22-bookworm-slim
WORKDIR /app
COPY --from=build /app/origin.mjs ./origin.mjs
USER node
ENV PORT=8080
EXPOSE 8080
CMD ["node", "origin.mjs"]
