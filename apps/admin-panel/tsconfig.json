{
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.iterable",
      "es6"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@features/*": [
        "./src/features/*"
      ],
      "@shared/*": [
        "./src/shared/*"
      ],
      "@widgets/*": [
        "./src/widgets/*"
      ],
      "@trainer-panel/*": [
        "../trainer-panel/src/*"
      ],
      "@gafus/types": [
        "../../packages/types/src"
      ],
      "@gafus/error-handling": [
        "../../packages/error-handling/src"
      ],
      "@gafus/prisma": [
        "../../packages/prisma/src/index.ts"
      ],
      "@gafus/auth": [
        "../../packages/auth/src"
      ],
      "@gafus/csrf": [
        "../../packages/csrf/src"
      ],
      "@gafus/react-query": [
        "../../packages/react-query/src"
      ],
      "@gafus/consultation-shared": [
        "../../packages/consultation-shared/src/index.ts"
      ],
      "@gafus/consultation-shared/*": [
        "../../packages/consultation-shared/src/*"
      ],
      "@gafus/ui-components": [
        "../../packages/ui-components/src/index.ts"
      ],
      "@gafus/ui-components/*": [
        "../../packages/ui-components/src/*"
      ],
      "@gafus/core": [
        "../../packages/core/src/index.ts"
      ],
      "@gafus/core/*": [
        "../../packages/core/src/*"
      ]
    },
    "target": "ES2017"
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}