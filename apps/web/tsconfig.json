{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    /* Базовые */
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "module": "ESNext",
    "moduleResolution": "Node",
    "jsx": "preserve",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "incremental": true,
    "types": [],
    /* Пути и алиасы для web */
    "baseUrl": ".",
    "paths": {
      "@gafus/core/services/cynologistChat": ["../../packages/core/src/services/cynologistChat/index.ts"],
      "@gafus/core/services/cynologistChat/http": ["../../packages/core/src/services/cynologistChat/http.ts"],
      "@/*": ["./src/*"],
      "@features/*": ["./src/features/*"],
      "@shared/*": ["./src/shared/*"],
      "@widgets/*": ["./src/widgets/*"],
      "@gafus/core": ["../../packages/core/src/index.ts"],
      "@gafus/core/services/course": ["../../packages/core/src/services/course/index.ts"],
      "@gafus/core/services/dailyCourse": [
        "../../packages/core/src/services/dailyCourse/index.ts"
      ],
      "@gafus/core/services/coursePath": ["../../packages/core/src/services/coursePath/index.ts"],
      "@gafus/core/services/diary": ["../../packages/core/src/services/diary/index.ts"],
      "@gafus/core/services/user": ["../../packages/core/src/services/user/index.ts"],
      "@gafus/core/services/auth": ["../../packages/core/src/services/auth/index.ts"],
      "@gafus/core/services/consent": ["../../packages/core/src/services/consent/index.ts"],
      "@gafus/consultation-shared": ["../../packages/consultation-shared/src/index.ts"],
      "@gafus/consultation-shared/*": ["../../packages/consultation-shared/src/*"],
      "@gafus/core/services/notifications": [
        "../../packages/core/src/services/notifications/index.ts"
      ],
      "@gafus/core/services/subscriptions": [
        "../../packages/core/src/services/subscriptions/index.ts"
      ],
      "@gafus/core/services/appSubscription": [
        "../../packages/core/src/services/appSubscription/index.ts"
      ],
      "@gafus/core/services/appFeatureFlags": [
        "../../packages/core/src/services/appFeatureFlags/index.ts"
      ],
      "@gafus/core/services/tracking": ["../../packages/core/src/services/tracking/index.ts"],
      "@gafus/core/services/article": [
        "../../packages/core/src/services/article/index.ts"
      ],
      "@gafus/core/services/achievements": [
        "../../packages/core/src/services/achievements/index.ts"
      ],
      "@gafus/metadata": ["../../packages/metadata/src/index.ts"],
      "@gafus/core/services/training": [
        "../../packages/core/dist/core/src/services/training/index.d.ts"
      ],
      "@gafus/core/services/training/trainingService": [
        "../../packages/core/dist/core/src/services/training/trainingService.d.ts"
      ],
      "@gafus/core/updatePetPhoto": [
        "../../packages/core/src/services/pets/petsService.ts"
      ],
      "@gafus/core/services/pets": ["../../packages/core/src/services/pets/index.ts"],
      "@gafus/core/services/petPrevention": [
        "../../packages/core/src/services/petPrevention/index.ts"
      ],
      "@gafus/core/services/notes": ["../../packages/core/src/services/notes/index.ts"],
      "@gafus/core/services/payments": ["../../packages/core/src/services/payments/index.ts"],
      "@gafus/core/services/reengagement": [
        "../../packages/core/src/services/reengagement/index.ts"
      ],
      "@gafus/core/services/survey": ["../../packages/core/src/services/survey/index.ts"],
      "@gafus/core/services/reminders": [
        "../../packages/core/src/services/reminders/index.ts"
      ],
      "@gafus/core/services/rewardedCredits": [
        "../../packages/core/src/services/rewardedCredits/index.ts"
      ],
      "@gafus/core/services/exam": ["../../packages/core/src/services/exam/index.ts"],
      "@gafus/core/services/offline": ["../../packages/core/src/services/offline/index.ts"],
      "@gafus/core/services/video": ["../../packages/core/src/services/video/index.ts"],
      "@gafus/core/services/trainerVideo": [
        "../../packages/core/src/services/trainerVideo/index.ts"
      ],
      "@gafus/core/errors": ["../../packages/core/src/errors/index.ts"],
      "@gafus/core/utils": ["../../packages/core/src/utils/index.ts"],
      "@gafus/core/utils/social": ["../../packages/core/src/utils/social.ts"],
      "@gafus/core/utils/training": ["../../packages/core/src/utils/training.ts"],
      "@gafus/core/utils/retry": ["../../packages/core/src/utils/retry.ts"],
      "@gafus/core/validation/auth-register": [
        "../../packages/core/src/validation/authRegisterSchema.ts"
      ],
      "@gafus/core/validation/pet": [
        "../../packages/core/src/validation/petSchema.ts"
      ],
      "@gafus/core/validation/email-domain-suggestion": [
        "../../packages/core/src/validation/emailDomainSuggestion.ts"
      ],
      "@gafus/csrf": ["../../packages/csrf/src/index.ts"],
      "@gafus/csrf/*": ["../../packages/csrf/src/*"],
      "@gafus/auth": ["../../packages/auth/dist/index.d.ts"],
      "@gafus/auth/*": ["../../packages/auth/dist/*"],
      "@gafus/prisma": ["../../packages/prisma/dist/index.d.ts"],
      "@gafus/prisma/*": ["../../packages/prisma/dist/*"],
      "@gafus/types": ["../../packages/types/src/index.ts"],
      "@gafus/types/*": ["../../packages/types/src/*"],
      "@gafus/error-handling": ["../../packages/error-handling/dist/index.d.ts"],
      "@gafus/error-handling/*": ["../../packages/error-handling/dist/*"],
      "@gafus/react-query": ["../../packages/react-query/dist/index.d.ts"],
      "@gafus/react-query/*": ["../../packages/react-query/dist/*"],
      "@gafus/webpush": ["../../packages/webpush/dist/index.js"],
      "@gafus/webpush/*": ["../../packages/webpush/dist/*"],
      "@gafus/ui-components": ["../../packages/ui-components/src/index.ts"],
      "@gafus/ui-components/*": ["../../packages/ui-components/src/*"],
      "@gafus/analytics": ["../../packages/analytics/src/index.ts"],
      "@gafus/analytics/web": ["../../packages/analytics/src/web.ts"],
      "@gafus/analytics/mobile": ["../../packages/analytics/src/mobile.ts"]
    },
    /* Типы */
    "typeRoots": ["./types", "../../node_modules/@types"],
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "../../packages/webpush/src/db.ts",
    "../../packages/webpush/src/index.ts",
    "next-env.d.ts",
    "src/utils/getCurrentUserId.ts",
    "src/utils/push.ts",
    ".next/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
