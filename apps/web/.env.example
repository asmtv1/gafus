# Yandex Metrica (product analytics; на web — только после согласия cookies)
# Счётчик: в корне репозитория .env / .env.local или здесь — next.config подмешивает корень перед build
# NEXT_PUBLIC_YM_COUNTER_ID=

# Лог в консоль браузера: [gafus:analytics] queued | sent
# При start:all: localStorage.setItem("gafus:analyticsDebug","1") → F5; в консоли сначала строка «отладка: … жду trackEvent»
# NEXT_PUBLIC_GAFUS_ANALYTICS_DEBUG=1

# Universal Links (iOS): Team ID из Apple Developer → Membership; без него AASA отдаёт пустой applinks
# APPLE_TEAM_ID=

# Apple IAP (verify на API / core; секреты ASC в репозиторий не класть)
# APPLE_BUNDLE_ID=ru.gafus.app
# APPLE_APP_ID=1234567890
# APPLE_USE_SANDBOX=true
# APPLE_ISSUER_ID=
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY_PATH=/run/secrets/apple_app_store_connect_api_key.p8
# APPLE_PRIVATE_KEY_HOST_PATH=/opt/gafus/secrets/AuthKey_FZ3FFU78RN.p8

# VK ID (web)
VK_CLIENT_ID=
VK_WEB_REDIRECT_URI=https://gafus.ru/api/auth/callback/vk-id

# Транзакционная почта (локально — свой SMTP или Mailpit; на проде — контейнер postfix)
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_SECURE=false
# MAIL_FROM=noreply@gafus.ru
# MAIL_FROM_NAME=Гафус
