    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-asset",
      [
        "expo-location",
        {
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true,
          "locationAlwaysAndWhenInUsePermission": "GAFUS записывает маршрут прогулки с собакой, даже когда экран телефона заблокирован. Геолокация используется только во время прогулки.",
          "locationWhenInUsePermission": "GAFUS использует геолокацию для отображения маршрута прогулки с собакой."
        }
      ],
      "expo-sqlite",
      "@maplibre/maplibre-react-native",
      "expo-video",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#B5E5EB",
          "ios": {
            "image": "./assets/images/startup-splash.png",
            "resizeMode": "contain",
            "enableFullScreenImage_legacy": true
          },
          "android": {
            "drawable": {
              "icon": "./assets/splash/transparent-icon.xml"
            }
          }
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 24,
            "extraMavenRepos": [
              "https://nexus-external.rustore.ru/repository/maven-rustore-exposed/"
            ]
          }
        }
      ],
      "./plugins/withAndroidTabletSupport",
      "./plugins/withMinSdkFromGradleProps",
      "./plugins/withIosAppMetrica516Compatibility",
      "./plugins/withAppTracerNative",
      "./plugins/withExpo55ReactHost",
      "./plugins/withExpo55IosAppDelegate",
      "./plugins/withVoximplantIosPods",
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#8936FF",
          "enableBackgroundRemoteNotifications": true
        }
      ],
      [
        "expo-screen-orientation",
        {
          "initialOrientation": "PORTRAIT"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Камера нужна для фото и видео в публикациях, профиле и экзаменах.",
          "microphonePermission": "Микрофон нужен для записи звука в видео публикаций и экзаменов.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Доступ к фото и видео нужен для публикаций, альбомов, аватара и фото питомца.",
          "cameraPermission": "Камера нужна для фото и видео в публикациях, профиле и экзаменах.",
          "microphonePermission": "Микрофон нужен для записи звука в видео публикаций и экзаменов."
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./node_modules/@expo-google-fonts/montserrat/400Regular/Montserrat_400Regular.ttf",
            "./node_modules/@expo-google-fonts/montserrat/500Medium/Montserrat_500Medium.ttf",
            "./node_modules/@expo-google-fonts/montserrat/700Bold/Montserrat_700Bold.ttf",
            "./assets/fonts/Impact.ttf",
            "./assets/fonts/MOSCOW2024.otf"
          ]
        }
      ],
      "expo-iap",
      [
        "expo-widgets",
        {
          "widgets": [
            {
              "name": "DogWalk",
              "displayName": "Прогулка с собакой",
              "description": "Таймер, шаги, расстояние и управление прогулкой",
              "supportedFamilies": [
                "systemMedium",
                "systemLarge"
              ]
            }
          ]
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "DogWalk",
              "label": "Прогулка с собакой",
              "description": "Время, шаги, метры: старт, пауза, конец",
              "minWidth": "250dp",
              "minHeight": "150dp",
              "targetCellWidth": 4,
              "targetCellHeight": 3,
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ],
      "./plugins/withDogWalkChronometer",
      "./plugins/withDogWalkBackgroundSteps",
      "./plugins/withHermesCompiler",
      "./plugins/withStartupWindowBackground",
      "./plugins/withDogWalkWidgetEmbed"
