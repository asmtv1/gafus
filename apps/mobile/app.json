{
  "expo": {
    "name": "Гафус",
    "slug": "gafus",
    "version": "1.7.1",
    "orientation": "default",
    "scheme": "gafus",
    "userInterfaceStyle": "automatic",
    "extra": {
      "eas": {
        "projectId": "6c36fab5-6226-450f-8ee5-64e9beeea7db"
      }
    },
    "icon": "./assets/images/icon512.png",
    "splash": {
      "image": "./assets/images/startup-splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#B5E5EB"
    },
    "androidStatusBar": {
      "backgroundColor": "#B5E5EB",
      "translucent": false
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ru.gafus.app",
      "buildNumber": "16",
      "associatedDomains": [
        "applinks:gafus.ru"
      ],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "appleTeamId": "PJQ8PP666S",
      "splash": {
        "image": "./assets/images/startup-splash.png",
        "resizeMode": "cover",
        "backgroundColor": "#B5E5EB"
      }
    },
    "android": {
      "splash": {
        "backgroundColor": "#B5E5EB"
      },
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon-foreground.png",
        "backgroundColor": "#dad3c1"
      },
      "package": "ru.gafus.app",
      "versionCode": 16,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "gafus.ru",
              "pathPrefix": "/training"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-asset",
      "expo-video",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#B5E5EB",
          "ios": {
            "image": "./assets/images/startup-splash.png",
            "resizeMode": "cover",
            "enableFullScreenImage_legacy": true
          },
          "android": {
            "drawable": {
              "icon": "./assets/splash/transparent-icon.xml"
            }
          }
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 24,
            "extraMavenRepos": [
              "https://nexus-external.rustore.ru/repository/maven-rustore-exposed/"
            ]
          }
        }
      ],
      "./plugins/withAndroidTabletSupport",
      "./plugins/withMinSdkFromGradleProps",
      "./plugins/withIosAppMetrica516Compatibility",
      "./plugins/withAndroidMavenMirror",
      "./plugins/withAppTracerNative",
      "./plugins/withExpo55ReactHost",
      "./plugins/withExpo55IosAppDelegate",
      "./plugins/withVoximplantIosPods",
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#8936FF",
          "enableBackgroundRemoteNotifications": true
        }
      ],
      [
        "expo-screen-orientation",
        {
          "initialOrientation": "PORTRAIT"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Камера нужна для фото и видео в публикациях, профиле и экзаменах.",
          "microphonePermission": "Микрофон нужен для записи звука в видео публикаций и экзаменов.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Доступ к фото и видео нужен для публикаций, альбомов, аватара и фото питомца.",
          "cameraPermission": "Камера нужна для фото и видео в публикациях, профиле и экзаменах.",
          "microphonePermission": "Микрофон нужен для записи звука в видео публикаций и экзаменов."
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./node_modules/@expo-google-fonts/montserrat/400Regular/Montserrat_400Regular.ttf",
            "./node_modules/@expo-google-fonts/montserrat/500Medium/Montserrat_500Medium.ttf",
            "./node_modules/@expo-google-fonts/montserrat/700Bold/Montserrat_700Bold.ttf",
            "./assets/fonts/Impact.ttf",
            "./assets/fonts/MOSCOW2024.otf"
          ]
        }
      ],
      "expo-iap"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/6c36fab5-6226-450f-8ee5-64e9beeea7db",
      "checkAutomatically": "ON_LOAD"
    }
  }
}
