{
  "compilerOptions": {
    "strict": true,
    "target": "ESNext",
    "lib": ["DOM", "ESNext"],
    "jsx": "react-native",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "allowJs": true,
    "noEmit": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@gafus/types": ["../../packages/types/src"],
      "@gafus/types/training": ["../../packages/types/src/data/training.ts"],
      "@gafus/types/offline-course": ["../../packages/types/src/contracts/offlineCourse.ts"],
      "@gafus/types/course-outline": ["../../packages/types/src/contracts/publicPaidCourseOutline.ts"],
      "@gafus/types/exam": ["../../packages/types/src/data/exam.ts"],
      "@gafus/types/notes": ["../../packages/types/src/data/notes.ts"],
      "@gafus/analytics": ["../../packages/analytics/src/index.ts"],
      "@gafus/analytics/mobile": ["../../packages/analytics/src/mobile.ts"],
      "@gafus/consultation-shared": ["../../packages/consultation-shared/src/index.ts"],
      "@gafus/consultation-shared/*": ["../../packages/consultation-shared/src/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts", "global.d.ts"],
  "exclude": ["node_modules", "modules/modules/yookassa-payments/package"],
  "extends": "expo/tsconfig.base"
}
