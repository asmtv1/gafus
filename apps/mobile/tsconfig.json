{
  "compilerOptions": {
    "strict": true,
    "target": "ESNext",
    "lib": ["DOM", "ESNext"],
    "jsx": "react-native",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "allowJs": true,
    "noEmit": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@gafus/types": ["../../packages/types/src"],
      "@gafus/analytics": ["../../packages/analytics/src/index.ts"],
      "@gafus/analytics/mobile": ["../../packages/analytics/src/mobile.ts"],
      "@gafus/consultation-shared": ["../../packages/consultation-shared/src/index.ts"],
      "@gafus/consultation-shared/*": ["../../packages/consultation-shared/src/*"],
      "@gafus/core/utils": ["../../packages/core/src/utils/index.ts"],
      "@gafus/core/utils/*": ["../../packages/core/src/utils/*"],
      "@gafus/core/validation/*": ["../../packages/core/src/validation/*"],
      "@gafus/core/services/auth/*": ["../../packages/core/src/services/auth/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts", "global.d.ts"],
  "exclude": ["node_modules"],
  "extends": "expo/tsconfig.base"
}
