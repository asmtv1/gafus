{
  "cli": {
    "version": ">= 5.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      }
    },
    "development-device": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": false
      }
    },
    "preview": {
      "channel": "preview",
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "channel": "production",
      "environment": "production",
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle",
        "credentialsSource": "local"
      },
      "env": {
        "JAVA_HOME": "/opt/homebrew/opt/openjdk@17",
        "ANDROID_HOME": "/Users/asmtv1/Library/Android/sdk",
        "ORG_GRADLE_PROJECT_android.minSdkVersion": "24",
        "GRADLE_OPTS": "-Xmx4096m -XX:MaxMetaspaceSize=2048m",
        "APP_ENV": "production",
        "EXPO_PUBLIC_API_BASE_URL": "https://api.gafus.ru",
        "EXPO_PUBLIC_YM_MOBILE_ENABLED": "true",
        "EXPO_PUBLIC_CHAT2_API_ORIGIN": "https://api.gafus.ru"
      }
    },
    "production-local": {
      "extends": "production",
      "autoIncrement": false,
      "env": {
        "JAVA_TOOL_OPTIONS": "-Djdk.tls.client.protocols=TLSv1.2 -Dhttps.protocols=TLSv1.2"
      }
    },
    "sdk57-testflight": {
      "channel": "preview",
      "environment": "preview",
      "distribution": "store",
      "autoIncrement": false,
      "ios": {
        "simulator": false
      },
      "env": {
        "APP_ENV": "preview",
        "GAFUS_OTA_TRANSPORT": "self-hosted",
        "EXPO_PUBLIC_TELEMETRY_ENABLED": "true",
        "EXPO_PUBLIC_API_BASE_URL": "https://api.gafus.ru"
      }
    },
    "sdk57-android-internal": {
      "channel": "preview",
      "environment": "preview",
      "distribution": "store",
      "autoIncrement": false,
      "android": {
        "buildType": "app-bundle",
        "credentialsSource": "local"
      },
      "env": {
        "APP_ENV": "preview",
        "GAFUS_OTA_TRANSPORT": "self-hosted",
        "ORG_GRADLE_PROJECT_android.minSdkVersion": "24",
        "EXPO_PUBLIC_TELEMETRY_ENABLED": "true",
        "EXPO_PUBLIC_API_BASE_URL": "https://api.gafus.ru"
      }
    },
    "ota-175-android-internal": {
      "channel": "production",
      "environment": "production",
      "distribution": "internal",
      "autoIncrement": false,
      "android": {
        "buildType": "apk",
        "credentialsSource": "local"
      },
      "env": {
        "APP_ENV": "production",
        "GAFUS_OTA_TRANSPORT": "self-hosted",
        "GAFUS_OTA_LOCAL_DEVICE_TEST": "true",
        "EXPO_PUBLIC_TELEMETRY_ENABLED": "true",
        "EXPO_PUBLIC_API_BASE_URL": "https://api.gafus.ru",
        "EXPO_PUBLIC_CHAT2_API_ORIGIN": "https://api.gafus.ru",
        "GAFUS_OTA_TARGET_PLATFORM": "android",
        "ORG_GRADLE_PROJECT_android.minSdkVersion": "24",
        "EXPO_PUBLIC_APP_VERSION": "1.7.5"
      }
    },
    "ota-175-ios-internal": {
      "channel": "production",
      "environment": "production",
      "distribution": "internal",
      "autoIncrement": false,
      "ios": {
        "simulator": false
      },
      "env": {
        "APP_ENV": "production",
        "GAFUS_OTA_TRANSPORT": "self-hosted",
        "GAFUS_OTA_LOCAL_DEVICE_TEST": "true",
        "EXPO_PUBLIC_TELEMETRY_ENABLED": "true",
        "EXPO_PUBLIC_API_BASE_URL": "https://api.gafus.ru",
        "EXPO_PUBLIC_CHAT2_API_ORIGIN": "https://api.gafus.ru",
        "GAFUS_OTA_TARGET_PLATFORM": "ios",
        "EXPO_PUBLIC_APP_VERSION": "1.7.5"
      }
    },
    "ota-176-android-store": {
      "extends": "production-local",
      "distribution": "store",
      "autoIncrement": false,
      "android": { "buildType": "app-bundle", "credentialsSource": "local" },
      "env": {
        "GAFUS_OTA_TRANSPORT": "self-hosted",
        "GAFUS_OTA_LOCAL_STORE_BUILD": "true",
        "GAFUS_OTA_TARGET_PLATFORM": "android",
        "GAFUS_OTA_NATIVE_RELEASE_DESCRIPTOR": ".ota-certs/android-store-native.json",
        "GAFUS_OTA_NATIVE_CERTIFICATE": ".ota-certs/native.pem",
        "EXPO_PUBLIC_APP_VERSION": "1.7.6",
        "EXPO_PUBLIC_TELEMETRY_ENABLED": "true",
        "EXPO_PUBLIC_ENABLE_TRACER": "false"
      }
    },
    "ota-175-ios-store": {
      "channel": "production",
      "environment": "production",
      "distribution": "store",
      "autoIncrement": false,
      "ios": {
        "simulator": false
      },
      "env": {
        "APP_ENV": "production",
        "GAFUS_OTA_TRANSPORT": "self-hosted",
        "GAFUS_OTA_LOCAL_STORE_BUILD": "true",
        "EXPO_PUBLIC_TELEMETRY_ENABLED": "true",
        "EXPO_PUBLIC_API_BASE_URL": "https://api.gafus.ru",
        "EXPO_PUBLIC_CHAT2_API_ORIGIN": "https://api.gafus.ru",
        "GAFUS_OTA_TARGET_PLATFORM": "ios",
        "EXPO_PUBLIC_APP_VERSION": "1.7.5",
        "GAFUS_OTA_NATIVE_RELEASE_DESCRIPTOR": ".ota-certs/ios-store-native.json",
        "GAFUS_OTA_NATIVE_CERTIFICATE": ".ota-certs/native.pem",
        "EXPO_PUBLIC_ENABLE_TRACER": "false",
        "EXPO_PUBLIC_YM_MOBILE_ENABLED": "true"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "your@email.com",
        "ascAppId": "123456789"
      },
      "android": {
        "serviceAccountKeyPath": "./google-services.json",
        "track": "internal"
      }
    }
  }
}
