{
  "cli": {
    "version": ">= 5.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      }
    },
    "development-device": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": false
      }
    },
    "preview": {
      "channel": "preview",
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "channel": "production",
      "environment": "production",
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle",
        "credentialsSource": "local"
      },
      "env": {
        "JAVA_HOME": "/opt/homebrew/opt/openjdk@17",
        "ANDROID_HOME": "/Users/asmtv1/Library/Android/sdk",
        "ORG_GRADLE_PROJECT_android.minSdkVersion": "24",
        "GRADLE_OPTS": "-Xmx4096m -XX:MaxMetaspaceSize=2048m",
        "APP_ENV": "production",
        "VK_CLIENT_ID": "54472652",
        "VK_CLIENT_ID_IOS": "54472654",
        "VK_CLIENT_ID_ANDROID": "54804685",
        "VK_MOBILE_REDIRECT_URI": "gafus://auth/vk",
        "EXPO_PUBLIC_API_BASE_URL": "https://api.gafus.ru",
        "EXPO_PUBLIC_YM_MOBILE_ENABLED": "true",
        "EXPO_PUBLIC_CHAT2_API_ORIGIN": "https://api.gafus.ru"
      }
    },
    "production-local": {
      "extends": "production",
      "autoIncrement": false,
      "env": {
        "JAVA_TOOL_OPTIONS": "-Djdk.tls.client.protocols=TLSv1.2 -Dhttps.protocols=TLSv1.2"
      }
    },
    "sdk57-testflight": {
      "channel": "preview",
      "environment": "preview",
      "distribution": "store",
      "autoIncrement": false,
      "ios": {
        "simulator": false
      },
      "env": {
        "APP_ENV": "preview",
        "GAFUS_OTA_TRANSPORT": "self-hosted",
        "EXPO_PUBLIC_TELEMETRY_ENABLED": "true",
        "EXPO_PUBLIC_API_BASE_URL": "https://api.gafus.ru"
      }
    },
    "sdk57-android-internal": {
      "channel": "preview",
      "environment": "preview",
      "distribution": "store",
      "autoIncrement": false,
      "android": {
        "buildType": "app-bundle",
        "credentialsSource": "local"
      },
      "env": {
        "APP_ENV": "preview",
        "GAFUS_OTA_TRANSPORT": "self-hosted",
        "ORG_GRADLE_PROJECT_android.minSdkVersion": "24",
        "EXPO_PUBLIC_TELEMETRY_ENABLED": "true",
        "EXPO_PUBLIC_API_BASE_URL": "https://api.gafus.ru"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "your@email.com",
        "ascAppId": "123456789"
      },
      "android": {
        "serviceAccountKeyPath": "./google-services.json",
        "track": "internal"
      }
    }
  }
}
