# Put local overrides in apps/mobile/.env.development.local.
# Expo Go on a real phone needs your computer LAN IP, not localhost.
# Example:
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.25:3001

EXPO_PUBLIC_API_BASE_URL=https://api.gafus.ru

# AppTracer native projects (Android/iOS)
EXPO_PUBLIC_TRACER_APP_TOKEN_ANDROID=
EXPO_PUBLIC_TRACER_APP_TOKEN_IOS=

# Dedicated JavaScript project "Гафус-mobile-js". Receives JS errors from
# both native platforms. Its pluginToken is configured separately below.
EXPO_PUBLIC_TRACER_APP_TOKEN_JS=
EXPO_PUBLIC_ENABLE_TRACER=true

# Keep build/upload tokens outside EXPO_PUBLIC_* variables.
TRACER_PLUGIN_TOKEN_ANDROID=
TRACER_PLUGIN_TOKEN_IOS=
TRACER_SOURCEMAP_TOKEN_MOBILE=
