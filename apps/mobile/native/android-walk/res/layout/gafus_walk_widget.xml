<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="6dp"
    android:gravity="center_vertical"
    android:background="@drawable/gafus_walk_card">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <Chronometer
            android:id="@+id/gafus_walk_chronometer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="10dp"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#242821"
            android:background="@drawable/gafus_walk_timer"
            android:gravity="center"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:fontFamily="sans"
            android:includeFontPadding="false" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_vertical">
            <TextView
                android:id="@+id/gafus_walk_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🐾 Не начата"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#315438"
                android:singleLine="true"
                android:ellipsize="end" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView
                    android:id="@+id/gafus_walk_metrics"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="7dp"
                    android:text="🐾 0 шагов"
                    android:textSize="13sp"
                    android:textColor="#38332C"
                    android:singleLine="true" />
                <TextView
                    android:id="@+id/gafus_walk_distance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📍 0 м"
                    android:textSize="13sp"
                    android:textColor="#38332C"
                    android:singleLine="true" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    <TextView
        android:id="@+id/gafus_walk_warning"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:text="Шаги могут быть неполными"
        android:textSize="11sp"
        android:textColor="#8B6D34"
        android:singleLine="true" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="6dp"
        android:baselineAligned="false">
        <TextView
            android:id="@+id/gafus_walk_start"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="3dp"
            android:gravity="center"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:singleLine="true"
            android:ellipsize="end"
            android:text="▶ Старт"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#336039"
            android:background="@drawable/gafus_walk_button_start"
            android:contentDescription="Начать или продолжить прогулку" />
        <TextView
            android:id="@+id/gafus_walk_pause"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="3dp"
            android:gravity="center"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:singleLine="true"
            android:ellipsize="end"
            android:text="Ⅱ Пауза"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#806322"
            android:background="@drawable/gafus_walk_button_pause"
            android:contentDescription="Приостановить прогулку" />
        <TextView
            android:id="@+id/gafus_walk_finish"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="3dp"
            android:gravity="center"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:singleLine="true"
            android:ellipsize="end"
            android:text="■ Конец"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#AD493D"
            android:background="@drawable/gafus_walk_button_finish"
            android:contentDescription="Завершить прогулку" />
    </LinearLayout>
</LinearLayout>
