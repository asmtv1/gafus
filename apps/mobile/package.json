{
  "name": "@gafus/mobile",
  "version": "1.7.6",
  "private": true,
  "main": "./widget-entry.ts",
  "scripts": {
    "android": "expo run:android",
    "android:release": "node ./scripts/run-signed-native-release.mjs android",
    "build:android:production:local": "node ./scripts/build-android-production-local.mjs",
    "eas-build-pre-upload-artifacts": "node ./scripts/verify-eas-native-ota-artifacts.mjs",
    "eas-build-on-success": "node ./scripts/verify-eas-native-ota-artifacts.mjs",
    "verify:ota:artifact": "python3 ./scripts/verify-native-ota-artifact.py",
    "verify:native-release": "node ./scripts/verify-no-vk-auth.mjs && node ./scripts/verify-native-release.mjs",
    "verify:android-aab-16k": "node ./scripts/verify-android-aab-16k.mjs",
    "verify:android-aab-compressor": "node ./scripts/verify-android-aab-compressor.mjs",
    "verify:android-aab-app-links": "node ./scripts/verify-android-aab-app-links.mjs",
    "postinstall": "cd ../.. && pnpm exec turbo run build --filter=@gafus/core-client --filter=@gafus/chat-media-quality --filter=@gafus/analytics --filter=@gafus/consultation-shared",
    "ios": "expo run:ios",
    "ios:release": "node ./scripts/run-signed-native-release.mjs ios",
    "lint": "eslint src app",
    "lint:fix": "eslint src app --fix",
    "start": "expo start",
    "start:dev-client": "expo start --dev-client",
    "start:go": "expo start --go",
    "test": "node ./scripts/verify-no-vk-auth.mjs && vitest run --config vitest.config.ts",
    "verify:no-vk-auth": "node ./scripts/verify-no-vk-auth.mjs",
    "typecheck": "tsc --noEmit",
    "web": "expo start --web",
    "build:ota:android:local": "node ./scripts/build-ota-175-local.mjs android",
    "build:ota:ios:local": "node ./scripts/build-ota-175-local.mjs ios",
    "check:ota:android:local": "node ./scripts/build-ota-175-local.mjs android --check",
    "check:ota:ios:local": "node ./scripts/build-ota-175-local.mjs ios --check",
    "ota:175:prepare": "node ./scripts/setup-ota-175-device.mjs prepare",
    "ota:175:finalize": "node ./scripts/setup-ota-175-device.mjs finalize",
    "ota:175:check": "node ./scripts/setup-ota-175-device.mjs check",
    "ota:175:build": "node ./scripts/setup-ota-175-device.mjs build",
    "ota:175:ios:store:prepare": "node ./scripts/ota-175-ios-store.mjs prepare",
    "ota:175:ios:store:finalize": "node ./scripts/ota-175-ios-store.mjs finalize",
    "ota:175:ios:store:check": "node ./scripts/ota-175-ios-store.mjs check",
    "ota:175:ios:store:build": "node ./scripts/ota-175-ios-store.mjs build",
    "ota:175:ios:store:verify-ipa": "node ./scripts/ota-175-ios-store.mjs verify-ipa"
  },
  "dependencies": {
    "@appmetrica/react-native-analytics": "^3.6.0",
    "@expo-google-fonts/anton": "^0.4.2",
    "@expo-google-fonts/montserrat": "^0.4.2",
    "@expo/dom-webview": "~57.0.1",
    "@expo/env": "2.0.12",
    "@expo/metro-runtime": "~57.0.18",
    "@expo/ui": "~57.0.26",
    "@expo/vector-icons": "^15.0.3",
    "@gafus/analytics": "workspace:*",
    "@gafus/chat-media-quality": "workspace:*",
    "@gafus/consultation-shared": "workspace:*",
    "@gafus/core-client": "workspace:*",
    "@gafus/logger": "workspace:*",
    "@gafus/types": "workspace:*",
    "@maplibre/maplibre-react-native": "^11.5.1",
    "@react-native-async-storage/async-storage": "~2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@shopify/flash-list": "^2.0.2",
    "@tanstack/react-query": "^5.62.16",
    "@voximplant/react-native-calls": "2.0.0",
    "@voximplant/react-native-core": "2.0.0",
    "centrifuge": "5.8.0",
    "expo": "57.0.33",
    "expo-application": "~57.0.3",
    "expo-asset": "~57.0.21",
    "expo-auth-session": "~57.0.17",
    "expo-build-properties": "~57.0.23",
    "expo-camera": "~57.0.6",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.24",
    "expo-crypto": "~57.0.4",
    "expo-dev-client": "~57.0.21",
    "expo-device": "~57.0.2",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-iap": "^3.4.13",
    "expo-image": "~57.0.5",
    "expo-image-manipulator": "~57.0.22",
    "expo-image-picker": "~57.0.21",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.14",
    "expo-location": "~57.0.23",
    "expo-notifications": "~57.0.25",
    "expo-observe": "~57.0.28",
    "expo-router": "~57.0.31",
    "expo-screen-capture": "~57.0.4",
    "expo-screen-orientation": "~57.0.3",
    "expo-secure-store": "~57.0.4",
    "expo-sensors": "~57.0.3",
    "expo-splash-screen": "~57.0.11",
    "expo-sqlite": "~57.0.5",
    "expo-status-bar": "~57.0.1",
    "expo-task-manager": "~57.0.23",
    "expo-updates": "~57.0.28",
    "expo-video": "~57.0.5",
    "expo-web-browser": "~57.0.3",
    "expo-widgets": "~57.0.28",
    "libphonenumber-js": "1.12.8",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-android-widget": "0.26.0",
    "react-native-compressor": "1.16.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-markdown-display": "^7.0.2",
    "react-native-paper": "^5.12.5",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-teleport": "1.2.2",
    "react-native-web": "~0.21.0",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1",
    "yandex-mobile-ads": "7.18.0",
    "zod": "^3.24.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@gafus/core": "workspace:*",
    "@types/react": "19.2.18",
    "babel-preset-expo": "~57.0.17",
    "typescript": "~5.9.3"
  },
  "expo": {
    "install": {
      "exclude": [
        "@types/react",
        "typescript"
      ]
    },
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-markdown-display"
        ],
        "listUnknownPackages": false
      }
    },
    "autolinking": {
      "android": {
        "exclude": [
          "yookassa-payments"
        ],
        "buildFromSource": [
          "expo-location"
        ]
      },
      "ios": {
        "buildFromSource": [
          "expo-widgets"
        ]
      }
    }
  }
}
