{
  "name": "@gafus/mobile",
  "version": "1.7.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "android": "expo run:android",
    "android:release": "expo run:android --device --variant release",
    "postinstall": "cd ../.. && pnpm exec turbo run build --filter=@gafus/logger --filter=@gafus/core",
    "ios": "expo run:ios",
    "ios:release": "expo run:ios --device --configuration Release",
    "lint": "eslint src app",
    "lint:fix": "eslint src app --fix",
    "start": "expo start",
    "test": "vitest run --config vitest.config.ts",
    "tracer:sourcemaps": "eas env:exec production 'node ./scripts/upload-apptracer-sourcemaps.mjs'",
    "typecheck": "tsc --noEmit",
    "update:ota:preview": "eas env:exec preview 'node ./scripts/publish-update-with-apptracer.mjs --channel preview --environment preview'",
    "update:ota:production": "eas env:exec production 'node ./scripts/publish-update-with-apptracer.mjs --channel production --environment production'",
    "web": "expo start --web"
  },
  "dependencies": {
    "@appmetrica/react-native-analytics": "^3.6.0",
    "@expo-google-fonts/anton": "^0.4.2",
    "@expo-google-fonts/montserrat": "^0.4.2",
    "@expo/env": "2.0.12",
    "@expo/vector-icons": "^15.0.3",
    "@gafus/analytics": "workspace:*",
    "@gafus/consultation-shared": "workspace:*",
    "@gafus/core": "workspace:*",
    "@gafus/logger": "workspace:*",
    "@gafus/types": "workspace:*",
    "@react-native-async-storage/async-storage": "~2.2.0",
    "@react-native-community/netinfo": "~11.5.2",
    "@react-navigation/native": "^7.1.33",
    "@shopify/flash-list": "^2.0.2",
    "@tanstack/react-query": "^5.62.16",
    "@voximplant/react-native-calls": "2.0.0",
    "@voximplant/react-native-core": "2.0.0",
    "expo": "55.0.31",
    "expo-application": "^55.0.19",
    "expo-asset": "~55.0.20",
    "expo-auth-session": "~55.0.18",
    "expo-build-properties": "^55.0.18",
    "expo-camera": "~55.0.23",
    "expo-clipboard": "~55.0.17",
    "expo-constants": "~55.0.17",
    "expo-crypto": "^55.0.19",
    "expo-dev-client": "~55.0.40",
    "expo-device": "~55.0.21",
    "expo-document-picker": "^55.0.17",
    "expo-file-system": "~55.0.26",
    "expo-font": "~55.0.8",
    "expo-haptics": "~55.0.18",
    "expo-iap": "^3.4.13",
    "expo-image": "~55.0.11",
    "expo-image-manipulator": "~55.0.21",
    "expo-image-picker": "^55.0.24",
    "expo-linear-gradient": "~55.0.18",
    "expo-linking": "~55.0.17",
    "expo-notifications": "~55.0.27",
    "expo-router": "~55.0.18",
    "expo-screen-capture": "~55.0.18",
    "expo-screen-orientation": "~55.0.20",
    "expo-secure-store": "~55.0.18",
    "expo-splash-screen": "~55.0.25",
    "expo-status-bar": "~55.0.6",
    "expo-updates": "~55.0.33",
    "expo-video": "~55.0.21",
    "expo-web-browser": "~55.0.20",
    "libphonenumber-js": "1.12.8",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.10",
    "react-native-gesture-handler": "~2.30.1",
    "react-native-markdown-display": "^7.0.2",
    "react-native-paper": "^5.12.5",
    "react-native-reanimated": "~4.2.1",
    "react-native-rustore-push": "^0.9.2",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "^15.15.3",
    "react-native-teleport": "1.2.2",
    "react-native-web": "~0.21.0",
    "react-native-webview": "^13.16.0",
    "react-native-worklets": "^0.7.4",
    "stream-chat": "9.53.0",
    "stream-chat-expo": "9.9.2",
    "yandex-mobile-ads": "7.18.0",
    "zod": "^3.24.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@apptracer/sourcemap": "^1.1.12",
    "@babel/core": "^7.26.0",
    "@types/react": "19.2.18",
    "typescript": "~5.9.3"
  },
  "expo": {
    "install": {
      "exclude": [
        "@types/react"
      ]
    },
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-markdown-display"
        ],
        "listUnknownPackages": false
      }
    }
  }
}
