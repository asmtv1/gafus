{
  "name": "@gafus/web-vite",
  "version": "1.7.3",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.mjs",
    "build": "vite build --config vite.config.mjs",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "lint": "eslint src vite.config.mjs",
    "test": "node --test vite.config.test.mjs && vitest run src --maxWorkers=1",
    "test:preview": "pnpm build && node --test ../../scripts/refactor/vite-preview-smoke.test.mjs",
    "test:visual": "node ../../scripts/refactor/run-visual-regression.mjs",
    "test:visual:update": "node ../../scripts/refactor/run-visual-regression.mjs --update"
  },
  "dependencies": {
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.0",
    "@gafus/cdn-upload": "workspace:*",
    "@gafus/chat-media-quality": "workspace:*",
    "@gafus/consultation-shared": "workspace:*",
    "@gafus/core-client": "workspace:*",
    "@gafus/types": "workspace:*",
    "@gafus/ui-components": "workspace:*",
    "@mui/icons-material": "7.1.0",
    "@mui/material": "7.1.0",
    "@tanstack/react-query": "5.90.20",
    "centrifuge": "5.8.0",
    "hls.js": "1.6.15",
    "maplibre-gl": "^6.16.0",
    "mediabunny": "1.62.1",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@gafus/core": "workspace:*",
    "@types/react": "19.1.9",
    "@types/react-dom": "19.1.7",
    "typescript": "5.8.3",
    "vite": "8.0.10",
    "vitest": "4.0.18"
  }
}
