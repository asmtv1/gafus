# GAFUS Refactor web — Vite static SPA (compiled by CI before docker build).
FROM nginx:1.27-alpine
COPY ci-cd/docker/nginx-vite-refactor.conf /etc/nginx/conf.d/default.conf
COPY apps/web-vite/dist/ /usr/share/nginx/html/
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 CMD wget -q -O /dev/null http://127.0.0.1:3000/healthz || exit 1
