{
  "id": null,
  "uid": "gafus-a2-storage-dependencies",
  "title": "GAFUS — Storage and Dependencies",
  "schemaVersion": 40,
  "version": 1,
  "editable": true,
  "tags": [
    "gafus",
    "observability",
    "storage",
    "agent2"
  ],
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "30s",
  "templating": {
    "list": [
      {
        "name": "environment",
        "label": "Environment",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "PBFA97CFB590B2093"
        },
        "query": "label_values(up, environment)",
        "includeAll": true,
        "allValue": ".*",
        "multi": false,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "PostgreSQL instance health",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "expr": "pg_up{environment=~\"$environment\"}",
          "refId": "A",
          "legendFormat": "{{instance}}",
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          }
        }
      ]
    },
    {
      "id": 2,
      "title": "Redis instance health",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "expr": "redis_up{environment=~\"$environment\"}",
          "refId": "A",
          "legendFormat": "{{instance}}",
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          }
        }
      ]
    },
    {
      "id": 3,
      "title": "PostgreSQL live connections",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "expr": "sum by (instance) (pg_stat_activity_count{environment=~\"$environment\"})",
          "refId": "A",
          "legendFormat": "{{instance}}",
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          }
        }
      ]
    },
    {
      "id": 4,
      "title": "PostgreSQL pool capacity ratio (exporter)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "gridPos": {
        "x": 12,
        "y": 7,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "expr": "sum by (instance) (pg_stat_activity_count{environment=~\"$environment\"}) / clamp_min(max by (instance) (pg_settings_max_connections{environment=~\"$environment\"}),1)",
          "refId": "A",
          "legendFormat": "{{instance}}",
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          }
        }
      ]
    },
    {
      "id": 5,
      "title": "Prisma query engine p95 duration",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le,instance) (rate(db_query_duration_seconds_bucket{environment=~\"$environment\"}[5m])))",
          "refId": "A",
          "legendFormat": "{{instance}}",
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          }
        }
      ]
    },
    {
      "id": 6,
      "title": "Prisma query throughput",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "gridPos": {
        "x": 12,
        "y": 14,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "expr": "sum by (instance) (rate(db_query_duration_seconds_count{environment=~\"$environment\"}[5m]))",
          "refId": "A",
          "legendFormat": "{{instance}}",
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          }
        }
      ]
    },
    {
      "id": 7,
      "title": "Redis memory used (bytes)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "expr": "sum by (instance) (redis_memory_used_bytes{environment=~\"$environment\"})",
          "refId": "A",
          "legendFormat": "{{instance}}",
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          }
        }
      ]
    },
    {
      "id": 8,
      "title": "Dependency failures by class",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "gridPos": {
        "x": 12,
        "y": 21,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "expr": "sum by (dependency,class) (rate(dependency_errors_total{environment=~\"$environment\"}[5m]))",
          "refId": "A",
          "legendFormat": "{{dependency}} / {{class}}",
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          }
        }
      ]
    },
    {
      "id": 9,
      "title": "Prisma pool connection wait p95 (real engine)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le,instance) (rate(db_pool_wait_seconds_bucket{environment=~\"$environment\"}[5m])))",
          "refId": "A",
          "legendFormat": "{{instance}}",
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          }
        }
      ],
      "description": "Time spent waiting for a free Prisma pool connection; a separate engine histogram from SQL execution duration. Require db_pool_wait_metrics_fresh == 1."
    },
    {
      "id": 10,
      "title": "Prisma pool metrics freshness",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "gridPos": {
        "x": 12,
        "y": 28,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "expr": "min by (instance) (db_pool_wait_metrics_fresh{environment=~\"$environment\"})",
          "refId": "A",
          "legendFormat": "{{instance}}",
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          }
        }
      ],
      "description": "1 when the engine pool-wait histogram was sampled at the latest metrics scrape, 0 if unavailable; do not treat stale wait data as zero."
    }
  ]
}
