prometheus.remote_write "yc" {
  endpoint {
    url = "https://monitoring.api.cloud.yandex.net/prometheus/workspaces/monj8dpjri8u0bbqvq71/api/v1/write"

    bearer_token = sys.env("YC_MONITORING_API_KEY")

    queue_config {
      max_samples_per_send = 2000
      batch_send_deadline  = "60s"
      min_backoff          = "100ms"
      max_backoff          = "60s"
    }

    metadata_config {
      send = false
    }
  }

  external_labels = {
    cluster     = "gafus",
    environment = "production",
  }
}

// В Yandex только: health (probe_success, pg_up), CPU/RAM/диск с node-exporter.
prometheus.relabel "yc_allowlist" {
  rule {
    source_labels = ["__name__"]
    regex         = "probe_success|pg_up|node_cpu_seconds_total|node_memory_MemTotal_bytes|node_memory_MemAvailable_bytes|node_memory_MemFree_bytes|node_memory_Buffers_bytes|node_memory_Cached_bytes|node_memory_SReclaimable_bytes|node_filesystem_avail_bytes|node_filesystem_size_bytes|gafus_mail_(stalled_pending|unresolved_unknown|expired_unknown|recent_failed|delivery_failures_24h|queue_failed|queue_expired|queue_stalled)|gafus_media_(worker_monitor_alive|pending|processing|stuck|failed|retries24h|completed24h|attention|cloudru_errors_(499|429|5xx|timeout))"
    action        = "keep"
  }
  forward_to = [prometheus.remote_write.yc.receiver]
}

prometheus.scrape "node_exporter" {
  targets = [{
    __address__ = "host.docker.internal:9100",
    instance    = "gafus-server",
    job         = "node-exporter",
  }]
  scrape_interval = "60s"
  forward_to      = [prometheus.relabel.yc_allowlist.receiver]
}

prometheus.scrape "postgres_exporter" {
  targets = [{
    __address__ = "postgres-exporter:9187",
    instance    = "gafus-postgres",
    job         = "postgres-exporter",
  }]
  scrape_interval = "60s"
  forward_to      = [prometheus.relabel.yc_allowlist.receiver]
}

// Health checks для сервисов через blackbox-exporter
prometheus.scrape "services_health" {
  targets = [
    { __address__ = "blackbox-exporter:9115", __param_target = "http://web:3000/api/health", instance = "http://web:3000/api/health", service = "web-app", job = "services-health" },
    { __address__ = "blackbox-exporter:9115", __param_target = "http://api:3001/health", instance = "http://api:3001/health", service = "api", job = "services-health" },
    { __address__ = "blackbox-exporter:9115", __param_target = "http://trainer-panel:3001/api/health", instance = "http://trainer-panel:3001/api/health", service = "trainer-panel", job = "services-health" },
    { __address__ = "blackbox-exporter:9115", __param_target = "http://admin-panel:3006/api/health", instance = "http://admin-panel:3006/api/health", service = "admin-panel", job = "services-health" },
    { __address__ = "blackbox-exporter:9115", __param_target = "http://worker:3003/health", instance = "http://worker:3003/health", service = "worker", job = "services-health" },
    { __address__ = "blackbox-exporter:9115", __param_target = "http://bull-board:3002/health", instance = "http://bull-board:3002/health", service = "bull-board", job = "services-health" },
  ]
  metrics_path    = "/probe"
  params          = { module = ["http_2xx"] }
  scrape_interval = "60s"
  forward_to      = [prometheus.relabel.yc_allowlist.receiver]

  clustering {
    enabled = false
  }
}


// Read-only mail delivery counters. Keep these separate from other worker metrics
// to ensure a slow NPD/subscription snapshot cannot hide mail delivery failures.
prometheus.scrape "worker_mail" {
  targets = [{
    __address__ = "worker:3003",
    instance    = "gafus-worker-mail",
    job         = "worker-mail",
  }]
  metrics_path    = "/metrics/mail"
  scrape_interval = "60s"
  forward_to      = [prometheus.relabel.yc_allowlist.receiver]
}

// Read-only media processing queue gauges and Cloud.ru API errors.
prometheus.scrape "worker_media" {
  targets = [{
    __address__ = "worker:3003",
    instance    = "gafus-worker-media",
    job         = "worker-media",
  }]
  metrics_path = "/metrics/media"
  scrape_interval = "60s"
  forward_to = [prometheus.relabel.yc_allowlist.receiver]
}
