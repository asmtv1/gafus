prometheus.remote_write "yc" {
  endpoint {
    url = "https://monitoring.api.cloud.yandex.net/prometheus/workspaces/monj8dpjri8u0bbqvq71/api/v1/write"

    bearer_token = sys.env("YC_MONITORING_API_KEY")

    queue_config {
      max_samples_per_send = 2000
      batch_send_deadline  = "60s"
      min_backoff          = "100ms"
      max_backoff          = "60s"
    }

    metadata_config {
      send = false
    }
  }

  external_labels = {
    cluster     = "gafus",
    environment = "production",
  }
}

// В Yandex только: health (probe_success, pg_up), CPU/RAM/диск с node-exporter.
prometheus.relabel "yc_allowlist" {
  rule {
    source_labels = ["__name__"]
    regex         = "probe_success|pg_up|redis_up|gafus_database_backup_last_success_timestamp_seconds|up|gafus_media_(stalled_processing|failed_tasks)|gafus_chat2_outbox_(pending|leased|dead_letters|oldest_age_seconds)|gafus_questions_legacy_delete_(enabled|pending|processing|failed|oldest_age_seconds)|job_attempts_total|job_failures_total|job_duration_seconds_(bucket|sum|count)|db_query_duration_seconds_(bucket|sum|count)|db_pool_wait_seconds_(bucket|sum|count)|db_pool_wait_metrics_fresh|pg_stat_activity_count|pg_settings_max_connections|http_requests_total|http_request_duration_seconds_(bucket|sum|count)|http_inflight_requests|node_cpu_seconds_total|node_memory_MemTotal_bytes|node_memory_MemAvailable_bytes|node_memory_MemFree_bytes|node_memory_Buffers_bytes|node_memory_Cached_bytes|node_memory_SReclaimable_bytes|node_filesystem_avail_bytes|node_filesystem_size_bytes|gafus_mail_(stalled_pending|unresolved_unknown|expired_unknown|recent_failed|delivery_failures_24h|queue_failed|queue_expired|queue_stalled)"
    action        = "keep"
  }
  forward_to = [prometheus.remote_write.yc.receiver]
}

prometheus.scrape "node_exporter" {
  targets = [{
    __address__ = "host.docker.internal:9100",
    instance    = "gafus-server",
    job         = "node-exporter",
  }]
  scrape_interval = "60s"
  forward_to      = [prometheus.relabel.yc_allowlist.receiver, prometheus.relabel.uptrace_allowlist.receiver]
}

prometheus.scrape "postgres_exporter" {
  targets = [{
    __address__ = "postgres-exporter:9187",
    instance    = "gafus-postgres",
    job         = "postgres-exporter",
  }]
  scrape_interval = "60s"
  forward_to      = [prometheus.relabel.yc_allowlist.receiver, prometheus.relabel.uptrace_allowlist.receiver]
}

// Health checks для сервисов через blackbox-exporter
prometheus.scrape "services_health" {
  targets = [
    { __address__ = "blackbox-exporter:9115", __param_target = "http://web:3000/healthz", instance = "http://web:3000/healthz", service = "web-app", job = "services-health" },
    { __address__ = "blackbox-exporter:9115", __param_target = "http://api:3001/health", instance = "http://api:3001/health", service = "api", job = "services-health" },
    { __address__ = "blackbox-exporter:9115", __param_target = "http://trainer-panel:3001/healthz", instance = "http://trainer-panel:3001/healthz", service = "trainer-panel", job = "services-health" },
    { __address__ = "blackbox-exporter:9115", __param_target = "http://admin-panel:3006/healthz", instance = "http://admin-panel:3006/healthz", service = "admin-panel", job = "services-health" },
    { __address__ = "blackbox-exporter:9115", __param_target = "http://worker:3003/health", instance = "http://worker:3003/health", service = "worker", job = "services-health" },
    { __address__ = "blackbox-exporter:9115", __param_target = "http://bull-board:3002/health", instance = "http://bull-board:3002/health", service = "bull-board", job = "services-health" },
  ]
  metrics_path    = "/probe"
  params          = { module = ["http_2xx"] }
  scrape_interval = "60s"
  forward_to      = [prometheus.relabel.yc_allowlist.receiver, prometheus.relabel.uptrace_allowlist.receiver]

  clustering {
    enabled = false
  }
}


// Read-only mail delivery counters. Keep these separate from other worker metrics
// to ensure a slow NPD/subscription snapshot cannot hide mail delivery failures.
prometheus.scrape "worker_mail" {
  targets = [{
    __address__ = "worker:3003",
    instance    = "gafus-worker-mail",
    job         = "worker-mail",
  }]
  metrics_path    = "/metrics/mail"
  scrape_interval = "60s"
  forward_to      = [prometheus.relabel.yc_allowlist.receiver, prometheus.relabel.uptrace_allowlist.receiver]
}

// Durable media status gauges, scraped separately from mail and subscriptions.
// Low-cardinality pipeline labels only: chat2, questions, feed, gallery.
prometheus.scrape "worker_media" {
  targets = [{
    __address__ = "worker:3003",
    instance    = "gafus-worker-media",
    job         = "worker-media",
  }]
  metrics_path    = "/metrics/media"
  scrape_interval = "60s"
  forward_to      = [prometheus.relabel.yc_allowlist.receiver, prometheus.relabel.uptrace_allowlist.receiver]
}


// Strictly internal metrics: the Bearer credential is a runtime secret, NOT
// committed to the repository. Without a configured API_METRICS_KEY the API
// deliberately responds 404, preventing unauthenticated metric disclosure.
prometheus.scrape "api_operations" {
  targets = [{
    __address__ = "api:3001",
    instance    = "gafus-api",
    job         = "api-operations",
  }]
  metrics_path    = "/internal/metrics"
  scrape_interval = "60s"
  authorization {
    type        = "Bearer"
    credentials = sys.env("API_METRICS_KEY")
  }
  forward_to = [prometheus.relabel.yc_allowlist.receiver, prometheus.relabel.uptrace_allowlist.receiver]
}

// Uptrace metrics run alongside Yandex; fixed-label privacy filter and durable WAL.
prometheus.relabel "uptrace_allowlist" {
  rule {
    source_labels = ["__name__"]
    regex = "probe_success|pg_up|redis_up|up|gafus_(mobile_telemetry|server_diagnostic_otlp|media|mail|chat2_outbox|http|queue|database_backup|questions_legacy_delete)_[a-zA-Z0-9_]+|http_requests_total|http_request_duration_seconds_(bucket|sum|count)|http_inflight_requests|node_cpu_seconds_total|node_memory_(MemTotal|MemAvailable)_bytes|node_filesystem_(avail|size)_bytes|pg_stat_activity_count|pg_settings_max_connections|job_(attempts|failures)_total|job_duration_seconds_(bucket|sum|count)|db_(query_duration|pool_wait)_seconds_(bucket|sum|count)"
    action = "keep"
  }
  // Replace URL-valued blackbox instance label with bounded service alias.
  rule {
    source_labels = ["service"]
    regex = "([a-z][a-z0-9-]{1,48})"
    target_label = "instance"
    replacement = "$1"
    action = "replace"
  }
  // Drop *all* labels except audited, bounded infrastructure/operation keys.
  // This applies to every scrape and protects against future accidental
  // dynamic user/device/request labels being added by a producer.
  rule {
    action = "labelkeep"
    regex = "__name__|job|instance|cluster|environment|service|status|status_class|method|route|le|cpu|mode|mountpoint|fstype|device|state|pipeline|task_type|outcome|phase|queue|source|error_class|dependency|resource|operation|role"
  }
  forward_to = [prometheus.remote_write.uptrace.receiver]
}
prometheus.remote_write "uptrace" {
  endpoint {
    url = "https://api.uptrace.dev/api/v1/prometheus/write"
    headers = {"uptrace-dsn" = sys.env("GAFUS_UPTRACE_INGEST_DSN")}
    queue_config {
      max_shards = 2
      capacity = 5000
      max_samples_per_send = 1000
      batch_send_deadline = "15s"
      retry_on_http_429 = true
    }
  }
  external_labels = {environment = "production", cluster = "gafus"}
}

prometheus.scrape "redis_exporter_uptrace" {
  targets = [{ __address__ = "redis-exporter:9121", instance = "gafus-redis", job = "redis-exporter" }]
  scrape_interval = "60s"
  forward_to = [prometheus.relabel.uptrace_allowlist.receiver]
}
prometheus.scrape "worker_telemetry_uptrace" {
  targets = [{ __address__ = "worker:3003", instance = "gafus-worker-telemetry", job = "worker-telemetry" }]
  metrics_path = "/metrics/mobile-telemetry"
  scrape_interval = "60s"
  forward_to = [prometheus.relabel.uptrace_allowlist.receiver]
}
