# GAFUS Refactor admin-panel — Vite static SPA (compiled by CI before docker build).
FROM nginx:1.27-alpine
COPY ci-cd/docker/nginx-admin-panel-vite.conf /etc/nginx/conf.d/default.conf
COPY apps/admin-panel/dist/ /usr/share/nginx/html/
EXPOSE 3006
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 CMD wget -q -O /dev/null http://127.0.0.1:3006/healthz || exit 1
