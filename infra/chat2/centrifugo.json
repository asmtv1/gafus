{
  "client": {
    "allowed_origins": ["http://127.0.0.1:5173", "http://localhost:5173"],
    "token": { "issuer": "gafus-chat2" }
  },
  "channel": {
    "namespaces": [{
      "name": "chat2",
      "history_size": 100,
      "history_ttl": "120s",
      "force_recovery": true
    }]
  },
  "engine": {
    "type": "redis",
    "redis": { "address": "redis://chat2-redis:6379" }
  }
}
