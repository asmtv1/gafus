{
  "name": "gafus.ru",
  "version": "1.7.3",
  "private": true,
  "description": "Комплексная система управления фитнес-тренировками с веб-приложением, панелью тренера, телеграм-ботом и системой мониторинга",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "pnpm check:core-boundaries && turbo run build",
    "build:all": "pnpm check:core-boundaries && pnpm --filter @gafus/prisma db:generate && pnpm -r --if-present run build",
    "build:ci": "pnpm check:core-boundaries && ./scripts/build-local.sh",
    "build:packages": "pnpm check:core-boundaries && pnpm --filter \"./packages/**\" run build",
    "check:builds": "node scripts/check-builds.js",
    "clean": "turbo run clean",
    "clean:all": "pnpm -r run clean",
    "clean:cache": "bash scripts/clean-cache.sh",
    "dev": "turbo run dev",
    "format": "prettier --cache --write .",
    "format:check": "prettier --check .",
    "preinstall": "only-allow pnpm",
    "lint": "turbo run lint",
    "lint:all": "pnpm -r run lint",
    "lint:fix": "turbo run lint:fix",
    "posthog:hobby": "bash docker/posthog/up.sh",
    "posthog:hobby:down": "bash docker/posthog/down.sh",
    "start": "pnpm --filter @gafus/web-vite dev",
    "start:worker:watch:simple": "nodemon",
    "test": "pnpm check:core-boundaries && turbo run test",
    "test:all": "pnpm check:core-boundaries && turbo run test",
    "test:api": "pnpm --filter @gafus/api test",
    "test:apps": "pnpm --filter @gafus/api test && pnpm --filter @gafus/web-vite test && pnpm --filter @gafus/mobile test",
    "test:cloudru-media": "node infra/cloudru/s3-cors.test.mjs && node infra/cloudru/media-manifests.test.mjs && node --test infra/cloudru/production-job-release.test.mjs ci-cd/scripts/questions-v2-production-readiness.test.mjs ci-cd/scripts/cloudru-first-main-cutover-contract.test.mjs && node infra/cloudru/cdn-edge-smoke.test.mjs && node infra/cloudru/cdn-stability.test.mjs && node infra/cloudru/cdn-edge-degradation.test.mjs && node infra/cloudru/yc-cdn-cli.test.mjs && node infra/cloudru/migrate-legacy-media.test.mjs && node infra/cloudru/multipart-smoke.test.mjs && node infra/cloudru/production-release.test.mjs",
    "test:coverage": "node scripts/qa/coverage-workspaces.mjs",
    "test:coverage:legacy": "turbo run test:coverage",
    "mobile:build": "node scripts/mobile-build.mjs",
    "test:mobile": "pnpm --filter @gafus/mobile test",
    "test:watch": "turbo run test:watch",
    "test:web": "pnpm --filter @gafus/web-vite test",
    "typecheck": "pnpm check:core-boundaries && turbo run typecheck",
    "typecheck:all": "pnpm check:core-boundaries && pnpm -r run typecheck",
    "db:generate": "pnpm --filter @gafus/prisma db:generate",
    "check:web-core-boundary": "node scripts/check-web-core-boundary.mjs && node scripts/check-core-client-boundary.mjs",
    "check:core-client-boundary": "node scripts/check-core-client-boundary.mjs && node --test scripts/check-core-client-boundary.test.mjs",
    "check:core-server-boundary": "node scripts/check-core-server-boundary.mjs",
    "check:workspace-public-exports": "node scripts/check-workspace-public-exports.mjs",
    "check:workspace-built-exports": "node scripts/check-workspace-public-exports.mjs --built",
    "check:feature-flag-policy": "node scripts/check-feature-flag-policy.mjs",
    "test:mobile-diagnostics": "node --test scripts/qa/mobile-diagnostic-pipeline.test.cjs",
    "check:mobile-diagnostic-catalog": "node scripts/check-mobile-diagnostic-catalog.cjs",
    "check:core-boundaries": "node scripts/check-mobile-diagnostic-catalog.cjs && node scripts/check-mobile-diagnostic-catches.cjs --require-zero && node --test scripts/qa/mobile-diagnostic-pipeline.test.cjs && node scripts/check-api-composition-installs.mjs --require-zero && node scripts/check-core-feed-persistence-ratchet.mjs --require-zero && node scripts/check-architecture-layers.mjs && node scripts/check-core-server-facades.mjs && node scripts/check-domain-package-prisma-boundary.mjs && node scripts/check-app-prisma-boundary.mjs && node scripts/check-worker-prisma-boundary.mjs && pnpm check:web-core-boundary && pnpm check:core-server-boundary && node scripts/check-utc-sql-clock.mjs && node scripts/check-types-logger-imports.mjs && node scripts/check-wire-contract-imports.mjs && node scripts/check-workspace-public-exports.mjs && node scripts/check-feature-flag-policy.mjs && node --test scripts/check-feature-flag-policy.test.mjs scripts/check-api-composition-installs.test.mjs scripts/check-core-feed-persistence-ratchet.test.mjs scripts/check-architecture-layers.test.mjs scripts/check-core-server-facades.test.mjs scripts/check-core-client-boundary.test.mjs scripts/check-types-logger-imports.test.mjs scripts/check-wire-contract-imports.test.mjs scripts/check-workspace-public-exports.test.mjs scripts/check-utc-sql-clock.test.mjs scripts/qa/training-source-no-shadow.test.mjs",
    "test:unit": "node scripts/qa/test-system.mjs run --profile unit",
    "test:integration": "node scripts/qa/test-system.mjs run --profile integration",
    "test:e2e:web": "node scripts/qa/test-system.mjs run --profile e2e-web",
    "test:e2e:mobile": "node scripts/qa/test-system.mjs run --profile e2e-mobile",
    "test:ci": "node scripts/qa/test-system.mjs run --profile ci",
    "test:full": "node scripts/qa/test-system.mjs run --profile full",
    "test:legacy": "node scripts/qa/test-system.mjs run --profile legacy",
    "test:inventory": "node scripts/qa/test-system.mjs inventory",
    "test:plan": "node scripts/qa/test-system.mjs plan",
    "test:system:contract": "node --test tests/support/report-contract.test.mjs tests/support/test-system-plan.test.mjs tests/support/coverage-contract.test.mjs tests/support/playwright-report-contract.test.mjs tests/support/web-vite-group-report.test.mjs tests/support/mobile-maestro-flow.test.mjs tests/support/mobile-preflight-report.test.mjs tests/support/mobile-adb-device-classifier.test.mjs tests/support/testing-ci-advisory.test.mjs tests/support/fault-report.test.mjs tests/support/coverage-risk-report.test.mjs tests/support/worker-recovery-report.test.mjs tests/support/api-auth-http-report.test.mjs tests/support/browser-cookie-report.test.mjs tests/support/account-delete-web-report.test.mjs tests/support/owned-vite-process.test.mjs tests/support/account-cleanup-worker-report.test.mjs tests/support/legacy-matrix-ledger.test.mjs",
    "test:coverage:pilot": "node scripts/qa/coverage-pilot.mjs",
    "test:e2e:mobile:preflight": "node scripts/qa/mobile-e2e-preflight.mjs",
    "test:web-vite": "node scripts/qa/test-system.mjs run --profile web-vite",
    "test:web-vite:inventory": "node scripts/qa/web-vite-group-inventory.mjs check",
    "test:mobile:preflight": "node scripts/qa/test-system.mjs run --profile native-preflight",
    "test:faults": "node scripts/qa/test-system.mjs run --profile faults",
    "test:coverage-risk": "node scripts/qa/test-system.mjs run --profile coverage-risk",
    "test:recovery": "node scripts/qa/test-system.mjs run --profile recovery",
    "test:api-acceptance": "node scripts/qa/test-system.mjs run --profile api-acceptance",
    "test:browser-cookie": "node scripts/qa/test-system.mjs run --profile browser-cookie",
    "test:account-delete-web": "node scripts/qa/test-system.mjs run --profile account-delete-web",
    "test:qa-vite-cleanup": "node --test tests/support/owned-vite-process.test.mjs",
    "test:account-cleanup-worker": "node scripts/qa/test-system.mjs run --profile account-cleanup-worker",
    "check:mobile-diagnostic-catches": "node scripts/check-mobile-diagnostic-catches.cjs --require-zero"
  },
