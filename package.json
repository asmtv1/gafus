      "cross-spawn@<6.0.6": ">=6.0.6",
      "dompurify@>=3.0.0 <3.4.17": "3.4.17",
      "esbuild@<=0.24.2": ">=0.25.0",
      "eslint-plugin-import>minimatch": "10.2.5",
      "eslint-plugin-react>minimatch": "10.2.5",
      "eslint>minimatch": "10.2.5",
      "fast-xml-builder@>=1.0.0 <1.1.7": "1.1.7",
