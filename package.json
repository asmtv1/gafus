{
  "name": "gafus.ru",
  "version": "1.7.2",
  "private": true,
  "description": "Комплексная система управления фитнес-тренировками с веб-приложением, панелью тренера, телеграм-ботом и системой мониторинга",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "pnpm check:core-boundaries && turbo run build",
    "build:all": "pnpm check:core-boundaries && pnpm --filter @gafus/prisma db:generate && pnpm -r --if-present run build",
    "build:ci": "pnpm check:core-boundaries && ./scripts/build-local.sh",
    "build:packages": "pnpm check:core-boundaries && pnpm --filter \"./packages/**\" run build",
    "check:builds": "node scripts/check-builds.js",
    "clean": "turbo run clean",
    "clean:all": "pnpm -r run clean",
    "clean:cache": "bash scripts/clean-cache.sh",
    "dev": "turbo run dev",
    "format": "prettier --cache --write .",
    "format:check": "prettier --check .",
    "preinstall": "only-allow pnpm",
    "lint": "turbo run lint",
    "lint:all": "pnpm -r run lint",
    "lint:fix": "turbo run lint:fix",
    "posthog:hobby": "bash docker/posthog/up.sh",
    "posthog:hobby:down": "bash docker/posthog/down.sh",
    "start": "pnpm --filter @gafus/web-vite dev",
    "start:worker:watch:simple": "nodemon",
    "test": "pnpm check:core-boundaries && turbo run test",
    "test:all": "pnpm check:core-boundaries && turbo run test",
    "test:api": "pnpm --filter @gafus/api test",
    "test:apps": "pnpm --filter @gafus/api test && pnpm --filter @gafus/web-vite test && pnpm --filter @gafus/mobile test",
    "test:cloudru-media": "node infra/cloudru/s3-cors.test.mjs && node infra/cloudru/media-manifests.test.mjs && node --test infra/cloudru/production-job-release.test.mjs ci-cd/scripts/questions-v2-production-readiness.test.mjs ci-cd/scripts/cloudru-first-main-cutover-contract.test.mjs && node infra/cloudru/cdn-edge-smoke.test.mjs && node infra/cloudru/cdn-stability.test.mjs && node infra/cloudru/cdn-edge-degradation.test.mjs && node infra/cloudru/yc-cdn-cli.test.mjs && node infra/cloudru/migrate-legacy-media.test.mjs && node infra/cloudru/multipart-smoke.test.mjs && node infra/cloudru/production-release.test.mjs",
    "test:coverage": "turbo run test:coverage",
    "test:mobile": "pnpm --filter @gafus/mobile test",
    "test:watch": "turbo run test:watch",
    "test:web": "pnpm --filter @gafus/web-vite test",
    "typecheck": "pnpm check:core-boundaries && turbo run typecheck",
    "typecheck:all": "pnpm check:core-boundaries && pnpm -r run typecheck",
    "db:generate": "pnpm --filter @gafus/prisma db:generate",
    "check:web-core-boundary": "node scripts/check-web-core-boundary.mjs && node scripts/check-core-client-boundary.mjs",
    "check:core-client-boundary": "node scripts/check-core-client-boundary.mjs && node --test scripts/check-core-client-boundary.test.mjs",
    "check:core-server-boundary": "node scripts/check-core-server-boundary.mjs",
    "check:core-boundaries": "pnpm check:web-core-boundary && pnpm check:core-server-boundary && node scripts/check-types-logger-imports.mjs && node --test scripts/check-core-client-boundary.test.mjs scripts/check-types-logger-imports.test.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.899.0",
    "@aws-sdk/s3-request-presigner": "^3.899.0",
    "@gafus/cdn-upload": "workspace:^",
    "@hookform/resolvers": "^5.2.2",
    "@tanstack/react-query": "^5.85.9",
    "@tanstack/react-query-devtools": "^5.85.9",
    "dotenv": "17.2.0",
    "sweetalert2": "^11.23.0",
    "expo": "~55.0.31",
    "react": "19.2.0",
    "react-native": "0.83.10"
  },
  "devDependencies": {
    "@asteasolutions/zod-to-openapi": "^8.1.0",
    "@eslint/eslintrc": "3.3.5",
    "@eslint/js": "9.39.2",
    "@tanstack/query-sync-storage-persister": "^5.85.9",
    "@tanstack/react-query-persist-client": "^5.85.9",
    "@types/node": "20.4.8",
    "@types/react": "~19.1.10",
    "@types/react-dom": "19.1.7",
    "@types/web-push": "3.6.4",
    "eslint": "9.39.2",
    "eslint-import-resolver-alias": "^1.1.2",
    "eslint-import-resolver-typescript": "3.10.1",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-unused-imports": "4.1.4",
    "globals": "15.15.0",
    "nodemon": "^3.1.14",
    "only-allow": "1.2.1",
    "prettier": "3.6.2",
    "prettier-plugin-packagejson": "2.5.19",
    "prettier-plugin-tailwindcss": "0.6.14",
    "rimraf": "5.0.1",
    "tsx": "4.19.0",
    "turbo": "2.5.4",
    "typescript": "5.8.3",
    "typescript-eslint": "8.54.0",
    "vitest": "^4.0.17",
    "zod-to-json-schema": "^3.24.6"
  },
  "packageManager": "pnpm@10.12.4",
  "pnpm": {
