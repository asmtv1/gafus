{
  "name": "gafus.ru",
  "version": "1.0.0",
  "private": true,
  "description": "Комплексная система управления фитнес-тренировками с веб-приложением, панелью тренера, телеграм-ботом и системой мониторинга",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "analyze:trainer": "pnpm --filter @gafus/trainer-panel analyze",
    "analyze:web": "pnpm --filter @gafus/web analyze",
    "build": "turbo run build",
    "build:all": "pnpm db:generate && pnpm -r run build",
    "build:ci": "./scripts/build-local.sh",
    "build:packages": "pnpm --filter \"./packages/**\" run build",
    "check:builds": "node scripts/check-builds.js",
    "check:ports": "node scripts/check-ports.js",
    "clean": "turbo run clean",
    "clean:all": "pnpm -r run clean",
    "clean:cache": "bash scripts/clean-cache.sh",
    "dev": "turbo run dev",
    "dev:env": "node -r dotenv/config scripts/dev-with-env.js",
    "format": "prettier --cache --write .",
    "format:check": "prettier --check .",
    "preinstall": "only-allow pnpm",
    "lint": "turbo run lint",
    "lint:all": "pnpm -r run lint",
    "lint:fix": "turbo run lint:fix",
    "migrate:video-cuid": "tsx scripts/migrate-video-paths-to-cuid.ts",
    "optimize:all": "pnpm analyze:web",
    "posthog:hobby": "bash docker/posthog/up.sh",
    "posthog:hobby:down": "bash docker/posthog/down.sh",
    "setup:env": "node scripts/setup-env.js",
    "start": "node scripts/start-all.js",
    "start:all": "node scripts/start-all.js",
    "start:worker:watch:simple": "nodemon",
    "test": "turbo run test",
    "test:all": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "test:watch": "turbo run test:watch",
    "typecheck": "turbo run typecheck",
    "typecheck:all": "pnpm -r run typecheck"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.899.0",
    "@aws-sdk/s3-request-presigner": "^3.899.0",
    "@gafus/cdn-upload": "workspace:^",
    "@hookform/resolvers": "^5.2.2",
    "@tanstack/react-query": "^5.85.9",
    "@tanstack/react-query-devtools": "^5.85.9",
    "dotenv": "17.2.0",
    "sweetalert2": "^11.23.0"
  },
  "devDependencies": {
    "@asteasolutions/zod-to-openapi": "^8.1.0",
    "@eslint/eslintrc": "3.3.5",
    "@eslint/js": "9.39.2",
    "@tanstack/query-sync-storage-persister": "^5.85.9",
    "@tanstack/react-query-persist-client": "^5.85.9",
    "@types/node": "20.4.8",
    "@types/react": "~19.1.10",
    "@types/react-dom": "19.1.7",
    "@types/web-push": "3.6.4",
    "eslint": "9.39.2",
    "eslint-config-next": "15.5.15",
    "eslint-import-resolver-alias": "^1.1.2",
    "eslint-import-resolver-typescript": "3.10.1",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-unused-imports": "4.1.4",
    "globals": "15.15.0",
    "next": "15.5.15",
    "nodemon": "^3.1.14",
    "only-allow": "1.2.1",
    "prettier": "3.6.2",
    "prettier-plugin-packagejson": "2.5.19",
    "prettier-plugin-tailwindcss": "0.6.14",
    "rimraf": "5.0.1",
    "tsx": "4.19.0",
    "turbo": "2.5.4",
    "typescript": "5.8.3",
    "typescript-eslint": "8.54.0",
    "vitest": "^4.0.17",
    "zod-to-json-schema": "^3.24.6"
  },
  "packageManager": "pnpm@10.12.4",
  "pnpm": {
    "overrides": {
      "@mui/icons-material": "7.1.0",
      "@mui/material": "7.1.0",
      "@mui/x-data-grid": "7.8.0",
      "@mui/x-date-pickers": "7.8.0",
      "@prisma/client": "6.10.1",
      "@types/react": "~19.1.10",
      "@types/react-dom": "19.1.7",
      "cross-spawn@<6.0.6": ">=6.0.6",
      "esbuild@<=0.24.2": ">=0.25.0",
      "eslint>minimatch": "10.2.5",
      "eslint-plugin-import>minimatch": "10.2.5",
      "eslint-plugin-react>minimatch": "10.2.5",
      "form-data@<2.5.4": ">=2.5.4",
      "got@<11.8.5": ">=11.8.5",
      "http-cache-semantics@<4.1.1": ">=4.1.1",
      "@hono/node-server@<1.19.10": ">=1.19.10",
      "@isaacs/brace-expansion": "5.0.1",
      "@xmldom/xmldom@<0.8.13": ">=0.8.13",
      "axios@<=1.13.4": ">=1.13.5",
      "basic-ftp@<5.3.0": ">=5.3.0",
      "fast-xml-parser@<5.5.6": ">=5.5.6",
      "flatted@<3.4.2": ">=3.4.2",
      "hono@<4.12.4": ">=4.12.4",
      "immutable@<3.8.3": ">=3.8.3",
      "lodash@<=4.17.23": ">=4.17.24",
      "lodash-es@<=4.17.23": ">=4.17.24",
      "minimatch@<3.1.4": ">=3.1.4",
      "minimatch@>=5.0.0 <5.1.8": ">=5.1.8",
      "minimatch@>=7.0.0 <7.4.8": ">=7.4.8",
      "minimatch@>=9.0.0 <9.0.7": ">=9.0.7",
      "minimatch@>=10.0.0 <10.2.3": ">=10.2.3",
      "minimatch@10.1.1": "10.2.5",
      "next": "15.5.15",
      "next-auth": "4.24.11",
      "node-forge@<1.4.0": ">=1.4.0",
      "path-to-regexp@<8.4.0": ">=8.4.0",
      "picomatch@<2.3.2": ">=2.3.2",
      "picomatch@>=3.0.0 <3.0.2": ">=3.0.2",
      "picomatch@>=4.0.0 <4.0.4": ">=4.0.4",
      "picomatch@4.0.3": "4.0.4",
      "@expo/cli>picomatch": "4.0.4",
      "prisma": "6.10.1",
      "react": "19.1.0",
      "react-dom": "19.1.0",
      "rollup@<2.80.0": ">=2.80.0",
      "rollup@>=4.0.0 <4.59.0": ">=4.59.0",
      "rollup@4.57.1": "4.59.0",
      "workbox-build>rollup": "4.59.0",
      "semver-regex@<3.1.3": ">=3.1.3",
      "semver-regex@<3.1.4": ">=3.1.4",
      "serialize-javascript@<=7.0.2": ">=7.0.3",
      "tar@<7.5.11": ">=7.5.11",
      "tough-cookie@<4.1.3": ">=4.1.3",
      "undici@<6.24.0": ">=6.24.0",
      "vite@>=7.0.0 <=7.3.1": ">=7.3.2",
      "zod": "^3.24.1"
    },
    "patchedDependencies": {}
  }
}
