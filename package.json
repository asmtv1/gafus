      "picomatch@4.0.3": "4.0.4",
      "picomatch@<2.3.2": ">=2.3.2",
      "picomatch@>=3.0.0 <3.0.2": ">=3.0.2",
      "picomatch@>=4.0.0 <4.0.4": ">=4.0.4",
      "postcss@>=8.0.0 <8.5.18": "8.5.18",
      "prisma": "6.10.1",
      "protobufjs@>=7.0.0 <7.6.1": "7.6.1",
      "proxy-addr@<2.0.8": ">=2.0.8",
