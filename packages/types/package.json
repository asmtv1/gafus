{
  "name": "@gafus/types",
  "version": "1.7.2",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./training-client": {
      "types": "./dist/training-client.d.ts",
      "default": "./dist/training-client.js"
    },
    "./logger": { "types": "./dist/logger.d.ts", "default": "./dist/logger.js" }
  },
  "typesVersions": { "*": {
    "training-client": ["dist/training-client.d.ts"],
    "logger": ["dist/logger.d.ts"]
  } },
  "scripts": {
    "build": "tsup && NODE_OPTIONS=--max-old-space-size=6144 tsc -p tsconfig.build.json --emitDeclarationOnly --declaration --declarationMap false --outDir dist && ts-add-js-extension --dir dist",
    "clean": "rimraf dist",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@gafus/logger": "workspace:*",
    "react-hook-form": "^7.53.2"
  },
  "devDependencies": {
    "@types/node": "20.4.8",
    "rimraf": "5.0.1",
    "ts-add-js-extension": "^1.6.6",
    "tsup": "^8.3.5",
    "typescript": "5.8.3"
  }
}
