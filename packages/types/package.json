{
  "name": "@gafus/types",
  "version": "1.7.3",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./course": { "types": "./dist/data/course.d.ts" },
    "./training-status": { "types": "./dist/utils/training-status.d.ts" },
    "./trainer-read-contracts": { "types": "./dist/data/trainer-read-contracts.d.ts" },
    "./survey": { "types": "./dist/data/survey.d.ts" },
    "./pet": { "types": "./dist/data/pet.d.ts" },
    "./notes": { "types": "./dist/data/notes.d.ts" },
    "./exam": { "types": "./dist/data/exam.d.ts" },
    "./training": { "types": "./dist/data/training.d.ts" },
    "./offline-course": { "types": "./dist/contracts/offlineCourse.d.ts" },
    "./course-outline": { "types": "./dist/contracts/publicPaidCourseOutline.d.ts" },
    "./training-client": {
      "types": "./dist/training-client.d.ts",
      "default": "./dist/training-client.js"
    },
    "./logger": { "types": "./dist/logger.d.ts", "default": "./dist/logger.js" }
  },
  "typesVersions": { "*": {
    "course": ["dist/data/course.d.ts"],
    "training-status": ["dist/utils/training-status.d.ts"],
    "trainer-read-contracts": ["dist/data/trainer-read-contracts.d.ts"],
    "survey": ["dist/data/survey.d.ts"],
    "pet": ["dist/data/pet.d.ts"],
    "notes": ["dist/data/notes.d.ts"],
    "exam": ["dist/data/exam.d.ts"],
    "training": ["dist/data/training.d.ts"],
    "offline-course": ["dist/contracts/offlineCourse.d.ts"],
    "course-outline": ["dist/contracts/publicPaidCourseOutline.d.ts"],
    "training-client": ["dist/training-client.d.ts"],
    "logger": ["dist/logger.d.ts"]
  } },
  "scripts": {
    "build": "tsup && NODE_OPTIONS=--max-old-space-size=6144 tsc -p tsconfig.build.json --emitDeclarationOnly --declaration --declarationMap false --outDir dist && ts-add-js-extension --dir dist",
    "clean": "rimraf dist",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@gafus/logger": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "20.4.8",
    "rimraf": "5.0.1",
    "ts-add-js-extension": "^1.6.6",
    "tsup": "^8.3.5",
    "typescript": "5.8.3"
  }
}
