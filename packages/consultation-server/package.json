{
  "name": "@gafus/consultation-server",
  "version": "1.7.3",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./admin-bookings": {
      "types": "./dist/adminBookingQueries.d.ts",
      "default": "./dist/adminBookingQueries.js"
    },
    "./booking-readback": {
      "types": "./dist/bookingIdempotencyReadback.d.ts",
      "default": "./dist/bookingIdempotencyReadback.js"
    },
    "./vox": {
      "types": "./dist/voximplantService.d.ts",
      "default": "./dist/voximplantService.js"
    },
    "./mail-delivery": {
      "types": "./dist/consultationEmailDelivery.d.ts",
      "default": "./dist/consultationEmailDelivery.js"
    },
    "./booking-application": {
      "types": "./dist/bookingApplication.d.ts",
      "default": "./dist/bookingApplication.js"
    },
    "./slot-service": {
      "types": "./dist/slotService.d.ts",
      "default": "./dist/slotService.js"
    }
  },
  "scripts": {
    "build": "tsc && ts-add-js-extension --dir dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@gafus/prisma": "workspace:*",
    "@gafus/subscription-read-server": "workspace:*",
    "@gafus/consultation-shared": "workspace:*",
    "@gafus/core": "workspace:*",
    "@gafus/consultation-query-server": "workspace:*",
    "@gafus/consultation-write-server": "workspace:*",
    "@gafus/logger": "workspace:*",
    "luxon": "^3.7.2"
  },
  "devDependencies": {
    "typescript": "5.8.3",
    "@types/node": "20.4.8",
    "ts-add-js-extension": "^1.6.6",
    "vitest": "4.1.0",
    "@types/luxon": "^3.7.1"
  }
}
