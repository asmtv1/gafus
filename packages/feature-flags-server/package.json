{
  "name": "@gafus/feature-flags-server",
  "version": "1.7.2",
  "private": true,
  "sideEffects": true,
  "type": "module",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "appFeatureFlagsService": [
        "dist/appFeatureFlagsService.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./appFeatureFlagsService": {
      "types": "./dist/appFeatureFlagsService.d.ts",
      "default": "./dist/appFeatureFlagsService.js"
    }
  },
  "scripts": {
    "build": "tsc && ts-add-js-extension --dir dist",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@gafus/prisma": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "20.4.8",
    "typescript": "5.8.3",
    "ts-add-js-extension": "^1.6.6"
  }
}
