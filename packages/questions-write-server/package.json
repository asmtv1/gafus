{
  "name": "@gafus/questions-write-server",
  "version": "1.7.3",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./service": {
      "types": "./dist/service.d.ts",
      "default": "./dist/service.js"
    },
    "./errors": {
      "types": "./dist/errors.d.ts",
      "default": "./dist/errors.js"
    },
    "./schemas": {
      "types": "./dist/schemas.d.ts",
      "default": "./dist/schemas.js"
    }
  },
  "scripts": {
    "build": "tsc && ts-add-js-extension --dir dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@gafus/prisma": "workspace:*",
    "@gafus/types": "workspace:*",
    "@gafus/gafus-server": "workspace:*",
    "@gafus/logger": "workspace:*",
    "zod": "^3.25.56",
    "@gafus/questions-shared": "workspace:*",
    "@gafus/media-server": "workspace:*"
  },
  "devDependencies": {
    "typescript": "5.8.3",
    "@types/node": "20.4.8",
    "ts-add-js-extension": "^1.6.6",
    "vitest": "4.1.0"
  }
}
