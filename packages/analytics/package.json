{
  "name": "@gafus/analytics",
  "version": "0.1.0",
  "private": true,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./web": {
      "types": "./dist/web.d.ts",
      "default": "./dist/web.js"
    },
    "./mobile": {
      "types": "./dist/mobile.d.ts",
      "default": "./dist/mobile.js"
    }
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "clean": "rimraf dist",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@gafus/types": "workspace:*",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^20.4.8",
    "rimraf": "^5.0.1",
    "typescript": "^5.8.3",
    "vitest": "^4.0.17"
  },
  "optionalDependencies": {
    "posthog-react-native": "^3.0.0"
  },
  "peerDependencies": {
    "posthog-react-native": "^3.0.0",
    "react": ">=19.0.0",
    "react-native": ">=0.78.0"
  },
  "peerDependenciesMeta": {
    "posthog-react-native": { "optional": true }
  }
}
