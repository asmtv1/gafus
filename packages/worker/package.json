{
  "name": "@gafus/worker",
  "version": "1.7.3",
  "private": true,
  "main": "dist/worker/src/index.js",
  "types": "dist/worker/src/index.d.ts",
  "scripts": {
    "prebuild": "pnpm clean",
    "build": "tsc -p tsconfig.json",
    "clean": "rimraf dist",
    "dev": "tsx --watch src/index.ts",
    "dev:env": "tsx --env-file=../../.env src/index.ts",
    "start": "node dist/worker/src/index.js",
    "start:dev": "tsx src/index.ts",
    "start:watch": "nodemon dist/worker/src/index.js --watch dist --ext js --ignore dist/**/*.map --exec 'node'",
    "npd:bootstrap": "tsx src/npd-bootstrap.ts",
    "npd:cutover": "tsx src/npd-cutover.ts",
    "test": "vitest run --config vitest.config.ts",
    "test:coverage": "vitest run --coverage --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "typecheck": "tsc --noEmit",
    "smart-ml:promote": "tsx src/smart-ml-promote.ts",
    "smart-ml:train": "tsx src/smart-ml-train.ts",
    "smart-feed:sql-smoke": "tsx tools/smart-feed-sql-smoke.ts",
    "smart-feed:redis-smoke": "tsx src/smart-feed-redis-smoke.ts",
    "smart-experiment:report": "tsx tools/smart-experiment-report.ts",
    "profit:sync": "tsx --env-file=../../.env src/profit-finance-sync.ts"
  },
  "dependencies": {
    "stream-chat": "9.53.0",
    "@apple/app-store-server-library": "^3.0.0",
    "@gafus/cdn-upload": "workspace:*",
    "@gafus/core": "workspace:*",
    "@gafus/logger": "workspace:*",
    "@gafus/mailer": "workspace:*",
    "@gafus/npd": "workspace:*",
    "@gafus/prisma": "workspace:*",
    "@gafus/queues": "workspace:*",
    "@gafus/reengagement": "workspace:*",
    "@gafus/types": "workspace:*",
    "@gafus/webpush": "workspace:*",
    "@types/luxon": "^3.7.1",
    "bullmq": "5.2.0",
    "ioredis": "5.3.2",
    "node-cron": "^3.0.3",
    "pg": "^8.23.0",
    "web-push": "3.6.6",
    "@gafus/consent-server": "workspace:*",
    "@gafus/gallery-storage": "workspace:*",
    "@gafus/feed-storage": "workspace:*",
    "@gafus/subscription-read-server": "workspace:*",
    "@gafus/statistics": "workspace:*",
    "@gafus/subscription-write-server": "workspace:*",
    "@gafus/notifications-server": "workspace:*",
    "@gafus/feed-server": "workspace:*",
    "@gafus/media-server": "workspace:*",
    "@gafus/questions-server": "workspace:*",
    "@gafus/exam-server": "workspace:*",
    "@gafus/gallery-server": "workspace:*",
    "@gafus/consultation-server": "workspace:*",
    "@gafus/subscription-finance-server": "workspace:*",
    "@gafus/subscription-payment-server": "workspace:*",
    "@gafus/subscription-shared": "workspace:*",
    "@gafus/pets-server": "workspace:*",
    "@gafus/identity-write-server": "workspace:*",
    "@gafus/mobile-ota-server": "workspace:*",
    "@gafus/achievements-server": "workspace:*",
    "@gafus/mobile-intro-server": "workspace:*",
    "@gafus/admin-rewarded-ads-server": "workspace:*",
    "@gafus/tracking-server": "workspace:*",
    "@gafus/admin-reengagement-server": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "20.4.8",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.23.1",
    "@types/web-push": "3.6.4",
    "@vitest/coverage-v8": "^4.1.0",
    "rimraf": "5.0.1",
    "tsx": "4.19.0",
    "typescript": "5.8.3",
    "vitest": "^4.0.17"
  }
}
