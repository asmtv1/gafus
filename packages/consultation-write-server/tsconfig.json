{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2023",
      "DOM"
    ],
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "types": [
      "node"
    ],
    "tsBuildInfoFile": "./dist/tsconfig.tsbuildinfo",
    "baseUrl": "../..",
    "paths": {
      "@gafus/prisma": [
        "packages/prisma/dist/index.d.ts"
      ],
      "@gafus/consultation-shared": [
        "packages/consultation-shared/dist/index.d.ts"
      ],
      "@gafus/consultation-query-server/booking-eligibility": [
        "packages/consultation-query-server/dist/bookingEligibility.d.ts"
      ],
      "@gafus/notifications-server/consultation-email-outbox": [
        "packages/notifications-server/dist/consultationEmailOutbox.d.ts"
      ],
      "@gafus/queues": [
        "packages/queues/dist/index.d.ts"
      ],
      "@gafus/logger": [
        "packages/logger/dist/index.d.ts"
      ]
    }
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "src/**/*.test.ts"
  ]
}
