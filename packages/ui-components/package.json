    "voximplant-websdk": "4.14.0-3018"
  },
  "devDependencies": {
    "@types/node": "^20.4.8",
    "@types/react": "19.1.9",
    "@types/react-dom": "19.1.7",
    "rimraf": "^5.0.1",
    "typescript": "^5.8.3"
  },
  "peerDependencies": {
    "react": "19.2.1",
    "react-dom": "19.2.1"
  }
