{
  "name": "@gafus/auth",
  "version": "1.7.0",
  "private": true,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./jwt": {
      "types": "./dist/jwt.d.ts",
      "default": "./dist/jwt.js"
    }
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc && ts-add-js-extension --dir dist",
    "clean": "rimraf dist",
    "test": "vitest run --config vitest.config.ts",
    "test:coverage": "vitest run --coverage --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@gafus/logger": "workspace:*",
    "@gafus/prisma": "workspace:*",
    "bcryptjs": "^3.0.2",
    "jose": "^5.10.0",
    "libphonenumber-js": "1.12.8",
    "@gafus/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "20.4.8",
    "@types/react": "19.1.9",
    "@types/react-dom": "19.1.7",
    "@vitest/coverage-v8": "^4.0.17",
    "rimraf": "5.0.1",
    "typescript": "5.8.3",
    "vitest": "^4.0.17",
    "ts-add-js-extension": "^1.6.6"
  },
  "peerDependencies": {},
  "type": "module"
}
