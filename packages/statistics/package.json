{
  "name": "@gafus/statistics",
  "version": "1.7.3",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc && ts-add-js-extension --dir dist",
    "clean": "rimraf dist",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@gafus/prisma": "workspace:*",
    "@gafus/types": "workspace:*",
    "zod": "^3.24.1",
    "@gafus/core": "workspace:*",
    "@gafus/logger": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "rimraf": "5.0.1",
    "typescript": "^5.8.3",
    "ts-add-js-extension": "^1.6.6",
    "vitest": "4.1.0"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./mail-monitoring": {
      "types": "./dist/mail-monitoring.d.ts",
      "default": "./dist/mail-monitoring.js"
    },
    "./database-health": {
      "types": "./dist/database-health.d.ts",
      "default": "./dist/database-health.js"
    },
    "./platform-stats": {
      "types": "./dist/platform-stats.d.ts",
      "default": "./dist/platform-stats.js"
    },
    "./user-search": {
      "types": "./dist/user-search.d.ts",
      "default": "./dist/user-search.js"
    },
    "./trainer-editor-counts": {
      "types": "./dist/trainer-editor-counts.d.ts",
      "default": "./dist/trainer-editor-counts.js"
    },
    "./trainer-video-playback": {
      "types": "./dist/trainer-video-playback.d.ts",
      "default": "./dist/trainer-video-playback.js"
    }
  }
}
