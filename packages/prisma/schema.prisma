  /// Legacy random code retained only to display old profiles/history. New profiles use promoCodeId.
  referralCode String? @unique @db.VarChar(32)
  /// A real Premium promo code is the sole public partner code. It may belong to one partner only.
  promoCodeId String? @unique
  promoCode AppSubscriptionPromoCode? @relation("PartnerProfilePromoCode", fields: [promoCodeId], references: [id], onDelete: Restrict)
  isActive Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  referrals PartnerReferral[] @relation("PartnerReferralPartner")
  commissions PartnerCommission[] @relation("PartnerCommissionPartner")
  payouts PartnerPayout[] @relation("PartnerPayoutPartner")
  videoExpenses ProfitVideoExpense[]
}

