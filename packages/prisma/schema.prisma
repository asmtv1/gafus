enum RewardedCreditTransactionType {
  EARN
  SPEND
  REFUND
  ADJUSTMENT
}

enum RewardedTargetType {
  ARTICLE
  COURSE_STEP
  DAILY_COURSE_STEP
  CONSULTATION_BOOKING
}

enum RewardedTargetAccessType {
  ARTICLE
  COURSE_STEP
}

enum RewardedTargetAccessSource {
  REWARDED_AD
  LEGACY_GAFUS
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  CANCELED
  REFUNDED
}

enum ArticleContentType {
  TEXT
  HTML
}

enum ArticleVisibility {
  PUBLIC
  PAID
}

model Article {
  id          String             @id @default(cuid())
  authorId    String
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  title       String
  contentType ArticleContentType @default(HTML)
  content     String             @db.Text
  visibility  ArticleVisibility  @default(PUBLIC)
  priceRub    Decimal?           @db.Decimal(10, 2)
  videoUrl    String?
  logoImg     String             @default("")
  imageUrls   String[]           @default([])
  slug        String             @unique
  viewCount   Int                @default(0)
  description String             @default("") @db.Text

  author       User               @relation("authoredArticles", fields: [authorId], references: [id])
  articleLikes ArticleLike[]
  access       ArticleAccess[]
  payments     ArticlePayment[]
  viewers      ArticleViewer[]
  guestViews   ArticleGuestView[]

  @@index([authorId])
  @@index([createdAt])
  @@index([visibility])
}

model ArticleLike {
  userId    String
  articleId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@id([userId, articleId])
  @@index([articleId])
  @@index([userId])
}

model ArticleAccess {
  userId    String
  articleId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([articleId, userId])
  @@index([articleId])
  @@index([userId])
}

/**
 * Уникальные авторизованные просмотры (для аналитики тренера); общий счётчик — Article.viewCount
 */
model ArticleViewer {
  articleId     String
  userId        String
  firstViewedAt DateTime @default(now())
  lastViewedAt  DateTime @default(now())

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([articleId, userId])
  @@index([articleId])
  @@index([userId])
}

/**
 * Уникальные гостевые просмотры по ключу с клиента (localStorage / AsyncStorage)
 */
model ArticleGuestView {
  articleId     String
  visitorKey    String
  firstViewedAt DateTime @default(now())

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@id([articleId, visitorKey])
  @@index([articleId])
}

model ArticlePayment {
  id                String        @id @default(cuid())
  userId            String
  articleId         String
  amountRub         Decimal       @db.Decimal(10, 2)
  currency          String        @default("RUB")
  yookassaPaymentId String?       @unique
  confirmationUrl   String?
  status            PaymentStatus @default(PENDING)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  article           Article       @relation(fields: [articleId], references: [id], onDelete: Cascade)
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([articleId])
  @@index([status])
}

/// Публичные флаги клиентов (мобильное приложение и т.д.). Ключ — стабильный идентификатор.
model AppFeatureFlag {
  key           String   @id @db.VarChar(64)
  enabled       Boolean  @default(false)
  reviewEnabled Boolean?
  updatedAt     DateTime @updatedAt
}

/// Управляет точной iOS-версией, которая должна получать review-профиль фича-флагов.
model MobileAppReleasePolicy {
  key              String   @id @default("default") @db.VarChar(32)
  iosReviewVersion String?  @db.VarChar(32)
  revision         Int      @default(1)
  updatedById      String?
  updatedBy        User?    @relation("MobileAppReleasePolicyUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// --- Консультации с кинологом (web + mobile) ---

enum ConsultationSlotStatus {
  FREE
  BOOKED
  BLOCKED
}

enum ConsultationBookingStatus {
  PENDING_TRAINER_CONFIRMATION
  CONFIRMED
  CANCELLED_BY_TRAINER
  CANCELLED_BY_USER
  CANCELLED_BY_SLA
  CANCELLED_BY_SYSTEM
  COMPLETED
  NO_SHOW
}

enum ConsultationPetGender {
  MALE
  FEMALE
}

enum ConsultationEmailType {
  TRAINER_CONFIRM_REQUEST
  CLIENT_BOOKING_RECEIVED
  CLIENT_BOOKING_CONFIRMED
  TRAINER_BOOKING_CONFIRMED
  CLIENT_BOOKING_CANCELLED_BY_TRAINER
  TRAINER_BOOKING_CANCELLED_BY_USER
  CLIENT_BOOKING_CANCELLED_BY_SLA
  /// Телемост не создался при записи, бронь снята системой
  CLIENT_BOOKING_TELEMOST_FAILED
  /// Напоминание за 30 минут (клиент)
  CLIENT_CONSULTATION_REMINDER_30M
  /// Клиенту: консультация начинается прямо сейчас
  CLIENT_CONSULTATION_START
  /// Напоминание за 30 минут (кинолог)
  TRAINER_CONSULTATION_REMINDER_30M
  /// Клиенту: тренер отметил, что подтверждённая консультация не состоялась
  CLIENT_CONSULTATION_NO_SHOW
}

enum ConsultationEmailStatus {
  PENDING
  SENT
  FAILED
}

/// Настройки кинолога для консультаций (роль TRAINER проверяется в core)
model ConsultationCynologist {
  id                 String   @id @default(cuid())
  userId             String   @unique
  isListed           Boolean  @default(false)
  telemostHostEmail  String?
  slotDurationMin    Int      @default(30)
  timezone           String   @default("Europe/Moscow")
  bookingLeadTimeMin Int      @default(60)
  slotHorizonDays    Int      @default(60)
  confirmationSlaMin Int      @default(1440)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user              User                           @relation(fields: [userId], references: [id], onDelete: Cascade)
  availabilityRules ConsultationAvailabilityRule[]
  dayOffs           ConsultationDayOff[]
  slotExceptions    ConsultationSlotException[]
  slots             ConsultationSlot[]
  bookings          ConsultationBooking[]

  @@index([isListed])
}

model ConsultationAvailabilityRule {
  id           String   @id @default(cuid())
  cynologistId String
  weekday      Int
  startTime    String
  endTime      String
  isWorkingDay Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  cynologist ConsultationCynologist @relation(fields: [cynologistId], references: [id], onDelete: Cascade)

  @@unique([cynologistId, weekday])
  @@index([cynologistId])
}

model ConsultationDayOff {
  id           String   @id @default(cuid())
  cynologistId String
  date         DateTime @db.Date
  reason       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  cynologist ConsultationCynologist @relation(fields: [cynologistId], references: [id], onDelete: Cascade)

  @@unique([cynologistId, date])
  @@index([cynologistId])
}

model ConsultationSlotException {
  id           String   @id @default(cuid())
  cynologistId String
  startAt      DateTime
  endAt        DateTime
  reason       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  cynologist ConsultationCynologist @relation(fields: [cynologistId], references: [id], onDelete: Cascade)

  @@index([cynologistId, startAt])
}

model ConsultationSlot {
  id           String                 @id @default(cuid())
  cynologistId String
  startAt      DateTime
  endAt        DateTime
  status       ConsultationSlotStatus @default(FREE)
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  cynologist ConsultationCynologist @relation(fields: [cynologistId], references: [id], onDelete: Cascade)
  bookings   ConsultationBooking[]

  @@unique([cynologistId, startAt])
  @@index([cynologistId, status, startAt])
}

model ConsultationBooking {
  id                     String                    @id @default(cuid())
  clientId               String
  cynologistId           String
  slotId                 String
  /// Имя владельца (как указано при записи)
  clientOwnerName        String?
  /// Телефон для связи, E.164 (+7…)
  clientPhone            String?
  petName                String?
  petGender              ConsultationPetGender?
  petAge                 String?
  petBreed               String?
  clientProblem          String?
  /// Как пытались решить проблему самостоятельно
  clientSelfHelpAttempt  String?
  status                 ConsultationBookingStatus @default(PENDING_TRAINER_CONFIRMATION)
  telemostConferenceId   String?
  telemostJoinUrl        String?
  telemostWatchUrl       String?
  /// Set only on new COMPLETED transitions; legacy completions do not start a cooldown.
  completedAt            DateTime?
  trainerConfirmedAt     DateTime?
  cancelReason           String?
  confirmationDeadlineAt DateTime
  createdAt              DateTime                  @default(now())
  updatedAt              DateTime                  @updatedAt

  client     User                   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  cynologist ConsultationCynologist @relation(fields: [cynologistId], references: [id], onDelete: Cascade)
  slot       ConsultationSlot       @relation(fields: [slotId], references: [id], onDelete: Restrict)
  emailLogs  ConsultationEmailLog[]

  @@index([slotId])
  @@index([cynologistId, status])
  @@index([clientId, createdAt])
  @@index([clientId, status, completedAt])
}

model ConsultationEmailLog {
  id        String                  @id @default(cuid())
  bookingId String
  type      ConsultationEmailType
  status    ConsultationEmailStatus @default(PENDING)
  attempts  Int                     @default(0)
  lastError String?
  sentAt    DateTime?
  createdAt DateTime                @default(now())
  updatedAt DateTime                @updatedAt

  booking ConsultationBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@unique([bookingId, type])
  @@index([bookingId, type])
}

model ConsultationBookingIdempotency {
  clientId     String
  key          String
  bookingId    String?
  responseJson Json
  expiresAt    DateTime

  client User @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@id([clientId, key])
  @@index([expiresAt])
}


model CynologistChat {
  id String @id @default(cuid())
  clientUserId String @unique
  trainerUserId String
  streamChannelId String @unique
  intake Json
  provisionStatus String @default("PENDING")
  firstMessageId String @unique
  lastMessageAt DateTime?
  lastClientMessageAt DateTime?
  trainerReadAt DateTime?
  unreadSince DateTime?
  nextReminderAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  client User @relation("ChatClient", fields: [clientUserId], references: [id], onDelete: Cascade)
  trainer User @relation("ChatTrainer", fields: [trainerUserId], references: [id], onDelete: Restrict)
  operations ChatSendOperation[]
  attachments ChatAttachment[]
  notifications ChatNotification[]
  @@index([trainerUserId, lastMessageAt])
  @@index([nextReminderAt])
}
model ChatSendOperation {
  id String @id @default(cuid())
  chatId String
  senderUserId String
  clientMessageId String
  streamMessageId String @unique
  payloadHash String
  state String @default("PENDING")
  createdAt DateTime @default(now())
  chat CynologistChat @relation(fields: [chatId], references: [id], onDelete: Cascade)
  @@unique([senderUserId, clientMessageId])
}
model ChatAttachment {
  id String @id @default(cuid())
  operationId String?
  chatId String
  ownerUserId String
  kind String
  url String
  mime String
  size Int
  name String
  state String @default("READY")
  createdAt DateTime @default(now())
  chat CynologistChat @relation(fields: [chatId], references: [id], onDelete: Cascade)
  @@index([state, createdAt])
}
model ChatWebhookEvent {
  id String @id
  payload Json
  processedAt DateTime?
  createdAt DateTime @default(now())
  @@index([processedAt, createdAt])
}
model ChatNotification {
  id String @id
  chatId String
  userId String
  notificationId String? @unique
  createdAt DateTime @default(now())
  chat CynologistChat @relation(fields: [chatId], references: [id], onDelete: Cascade)
}

model CommunityChatSendOperation {
  id String @id @default(cuid())
  senderUserId String
  clientMessageId String
  streamMessageId String @unique
  payloadHash String
  state String @default("PENDING")
  createdAt DateTime @default(now())
  sender User @relation(fields: [senderUserId], references: [id], onDelete: Cascade)
  @@unique([senderUserId, clientMessageId])
}

model CommunityChatAttachment {
  id String @id @default(cuid())
  operationId String?
  ownerUserId String
  kind String
  url String
  mime String
  size Int
  name String
  state String @default("READY")
  createdAt DateTime @default(now())
  owner User @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  @@index([state, createdAt])
}

/// Financial ledger only; does not alter subscription access or tax receipts.
model AppSubscriptionFinanceRefund {
  id String @id @default(cuid())
  providerRefundId String @unique
  paymentId String
  payment AppSubscriptionPayment @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  amountKopecks Int
  refundedAt DateTime
  createdAt DateTime @default(now())
  @@index([refundedAt, paymentId])
  @@index([paymentId])
}

model ProfitVideoExpense {
  id String @id @default(cuid())
  requestKey String @unique @db.VarChar(64)
  version Int @default(1)
  partnerId String
  partner PartnerProfile @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  paidAt DateTime
  quantity Int
  unitPriceKopecks Int @default(50000)
  amountKopecks Int
  comment String? @db.VarChar(512)
  actorId String
  actor User @relation(fields: [actorId], references: [id], onDelete: Restrict)
  canceledAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  revisions ProfitVideoExpenseRevision[]
  @@index([paidAt, canceledAt])
  @@index([partnerId, paidAt])
}

model ProfitVideoExpenseRevision {
  id String @id @default(cuid())
  expenseId String
  expense ProfitVideoExpense @relation(fields: [expenseId], references: [id], onDelete: Restrict)
  actorId String
  action String @db.VarChar(16)
  snapshot Json
  createdAt DateTime @default(now())
  @@index([expenseId, createdAt])
}

// Community questions. All permissions and state transitions live in core.
model Question {
  id              String           @id @default(cuid())
  authorId        String
  clientRequestId String
  title           String           @db.VarChar(150)
  body            String           @db.Text
  category        String
  tags            String[]         @default([])
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  editedAt        DateTime?
  activityAt      DateTime         @default(now())
  closedAt        DateTime?
  deletedAt       DateTime?
  hiddenAt        DateTime?
  bestAnswerId    String?          @unique
  author          User             @relation(fields: [authorId], references: [id], onDelete: Cascade)
  answers         QuestionAnswer[] @relation("QuestionAnswers")
  bestAnswer      QuestionAnswer?  @relation("QuestionBestAnswer", fields: [bestAnswerId], references: [id], onDelete: SetNull)
  photos          QuestionPhoto[]
  views           QuestionView[]
  reports         QuestionReport[]

  @@unique([authorId, clientRequestId])
  @@index([createdAt, id])
  @@index([activityAt, id])
  @@index([authorId, createdAt])
  @@index([category, createdAt])
}

model QuestionAnswer {
  id              String           @id @default(cuid())
  questionId      String
  authorId        String
  clientRequestId String
  body            String           @db.Text
  parentId        String?
  replyToId       String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  editedAt        DateTime?
  deletedAt       DateTime?
  hiddenAt        DateTime?
  question        Question         @relation("QuestionAnswers", fields: [questionId], references: [id], onDelete: Cascade)
  chosenIn        Question?        @relation("QuestionBestAnswer")
  author          User             @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent          QuestionAnswer?  @relation("AnswerThread", fields: [parentId], references: [id], onDelete: SetNull)
  children        QuestionAnswer[] @relation("AnswerThread")
  replyTo         QuestionAnswer?  @relation("AnswerReply", fields: [replyToId], references: [id], onDelete: SetNull)
  replies         QuestionAnswer[] @relation("AnswerReply")
  hearts          QuestionHeart[]
  photos          QuestionPhoto[]
  reports         QuestionReport[]

  @@unique([authorId, clientRequestId])
  @@index([questionId, parentId, createdAt])
  @@index([authorId, createdAt])
  @@index([replyToId])
}

model QuestionHeart {
  answerId  String
  userId    String
  createdAt DateTime       @default(now())
  answer    QuestionAnswer @relation(fields: [answerId], references: [id], onDelete: Cascade)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([answerId, userId])
  @@index([userId])
}

model QuestionView {
  questionId String
  userId     String
  createdAt  DateTime @default(now())
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([questionId, userId])
  @@index([userId])
}

model QuestionPhoto {
  id          String          @id @default(cuid())
  ownerId     String
  url         String
  storagePath String
  questionId  String?
  answerId    String?
  createdAt   DateTime        @default(now())
  owner       User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  question    Question?       @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answer      QuestionAnswer? @relation(fields: [answerId], references: [id], onDelete: Cascade)

  @@index([ownerId, createdAt])
  @@index([questionId])
  @@index([answerId])
}

model QuestionReport {
  id         String          @id @default(cuid())
  reporterId String
  questionId String
  answerId   String?
  targetKey  String
  reason     String
  details    String          @default("")
  createdAt  DateTime        @default(now())
  resolvedAt DateTime?
  resolution String?
  reporter   User            @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  question   Question        @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answer     QuestionAnswer? @relation(fields: [answerId], references: [id], onDelete: Cascade)

  @@unique([reporterId, targetKey])
  @@index([resolvedAt, createdAt])
  @@index([questionId])
  @@index([answerId])
}

model QuestionBlock {
  userId    String   @id
  reason    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}


// Gallery states use the same lowercase values as the shared DTOs.
enum GalleryPhotoStatus {
  pending
  processing
  ready
  moving
  failed
}
enum GalleryUploadStatus {
  reserved
  uploaded
  processing
  ready
  failed
  cancelled
  expired
}
enum GalleryStorageJobKind {
  publish
  move
  delete
}
enum GalleryStorageJobStatus {
  pending
  processing
  done
  failed
  cancelled
}
model GalleryAlbum {
  id String @id @default(cuid())
  ownerId String
  name String @db.VarChar(120)
  description String? @db.VarChar(2000)
  isVisible Boolean @default(true)
  // Application validates same-album READY cover under the owner lock.
  coverPhotoId String?
  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  photos GalleryPhoto[]
  @@index([ownerId, deletedAt, createdAt, id])
}
model GalleryPhoto {
  id String @id @default(cuid())
  ownerId String
  albumId String
  caption String? @db.VarChar(2000)
  status GalleryPhotoStatus @default(pending)
  thumbKey String?
  fullKey String?
  width Int?
  height Int?
  reservationExpiresAt DateTime
  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  album GalleryAlbum @relation(fields: [albumId], references: [id], onDelete: Cascade)
  upload GalleryUpload?
  @@index([ownerId, deletedAt, status, reservationExpiresAt])
  @@index([albumId, deletedAt, createdAt, id])
}
model GalleryUpload {
  id String @id @default(cuid())
  ownerId String
  photoId String @unique
  clientRequestId String @db.VarChar(36)
  requestFingerprint String
  // A retry creates a new photo/key generation; no old callback can overwrite it.
  retryOfId String? @unique
  retryCount Int @default(0)
  filename String @db.VarChar(255)
  declaredMime String @db.VarChar(64)
  declaredBytes Int
  sourceKey String @unique
  sourceETag String?
  status GalleryUploadStatus @default(reserved)
  postExpiresAt DateTime
  reservationExpiresAt DateTime
  attempts Int @default(0)
  attemptToken String? @unique
  leaseUntil DateTime?
  nextAttemptAt DateTime @default(now())
  stagedThumbKey String?
  stagedFullKey String?
  errorCode String? @db.VarChar(64)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  photo GalleryPhoto @relation(fields: [photoId], references: [id], onDelete: Cascade)
  @@unique([ownerId, clientRequestId])
  @@index([status, reservationExpiresAt, leaseUntil])
}
// No foreign keys: jobs and their immutable key snapshots survive account cascades.
model GalleryStorageJob {
  id String @id @default(cuid())
  dedupeKey String @unique
  ownerId String
  photoId String?
  uploadId String?
  destinationAlbumId String?
  kind GalleryStorageJobKind
  status GalleryStorageJobStatus @default(pending)
  sourceKeys String[]
  sourceETags String[]
  targetKeys String[]
  width Int?
  height Int?
  availableAt DateTime @default(now())
  attempts Int @default(0)
  attemptToken String? @unique
  leaseUntil DateTime?
  errorCode String? @db.VarChar(64)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status, availableAt, leaseUntil])
  @@index([ownerId, photoId])
}

// The feed has independent storage, revisions and cleanup lifecycles from gallery.
enum FeedPostStatus {
  draft
  pending
  published
  failed
  deleted
}

enum FeedRevisionStatus {
  draft
  pending
  ready
  failed
  superseded
}

enum FeedMediaKind {
  photo
  video
}

enum FeedMediaStatus {
  reserved
  uploaded
  processing
  ready
  failed
  cancelled
  expired
}

enum FeedJobKind {
  copy_album
  publish_photo
  publish_video
  delete_keys
  cleanup_source
}

enum FeedJobStatus {
  pending
  processing
  completed
  failed
}

enum FeedReactionKind {
  heart
  laugh
  dog
  fire
  like
}

enum FeedNotificationKind {
  author_post
  comment
  reply
  post_reaction
  comment_reaction
}

model FeedPost {
  moderationState String @default("visible") @db.VarChar(16)
  moderationReason String? @db.VarChar(1000)
  moderatedAt DateTime?
  bookmarks FeedBookmark[]
  feedback FeedUserPostFeedback[]
  impressions FeedImpression[]
  rankingEvents FeedRankingEvent[]
  rankingStats FeedPostStats?
  id String @id @default(cuid())
  authorId String
  status FeedPostStatus @default(draft)
  clientRequestId String @db.VarChar(64)
  version Int @default(0)
  activeRevisionId String?
  publishedAt DateTime?
  editedAt DateTime?
  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)
  revisions FeedPostRevision[]
  media FeedMediaAsset[]
  uploads FeedUpload[]
  comments FeedComment[]
  reactions FeedPostReaction[]
  views FeedPostView[]
  notifications FeedNotification[]
  @@unique([authorId, clientRequestId])
  @@index([status, publishedAt(sort: Desc), id(sort: Desc)])
  @@index([authorId, status, publishedAt(sort: Desc), id(sort: Desc)])
  @@index([authorId, deletedAt, updatedAt])
}

model FeedPostRevision {
  id String @id @default(cuid())
  postId String
  revisionNumber Int
  status FeedRevisionStatus @default(draft)
  text String @default("") @db.VarChar(5000)
  clientRequestId String @db.VarChar(64)
  acceptedAt DateTime?
  errorCode String? @db.VarChar(64)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  post FeedPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  attachments FeedRevisionAttachment[]
  @@unique([postId, revisionNumber])
  @@unique([postId, clientRequestId])
  @@index([postId, status, createdAt])
}

model FeedMediaAsset {
  id String @id @default(cuid())
  postId String
  ownerId String
  kind FeedMediaKind
  status FeedMediaStatus @default(reserved)
  width Int?
  height Int?
  durationSeconds Float?
  thumbKey String?
  fullKey String?
  posterKey String?
  playlistKey String?
  videoSegmentKeys String[] @default([])
  errorCode String? @db.VarChar(64)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  post FeedPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  upload FeedUpload?
  attachments FeedRevisionAttachment[]
  @@index([postId, status])
  @@index([ownerId, status])
}

model FeedRevisionAttachment {
  revisionId String
  mediaId String
  position Int
  revision FeedPostRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  media FeedMediaAsset @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  @@id([revisionId, mediaId])
  @@unique([revisionId, position])
  @@index([mediaId])
}

model FeedUpload {
  id String @id @default(cuid())
  ownerId String
  postId String
  mediaId String @unique
  clientRequestId String @db.VarChar(64)
  requestFingerprint String
  filename String @db.VarChar(255)
  declaredMime String @db.VarChar(64)
  declaredBytes Int
  sourceKey String @unique
  sourceETag String?
  status FeedMediaStatus @default(reserved)
  postExpiresAt DateTime
  reservationExpiresAt DateTime
  attempts Int @default(0)
  attemptToken String? @unique
  leaseUntil DateTime?
  nextAttemptAt DateTime @default(now())
  errorCode String? @db.VarChar(64)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  post FeedPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  media FeedMediaAsset @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  @@unique([ownerId, clientRequestId])
  @@index([status, reservationExpiresAt, leaseUntil])
  @@index([postId, status])
}

// No FK: immutable storage keys survive account/post cascades until cleanup succeeds.
model FeedStorageJob {
  id String @id @default(cuid())
  dedupeKey String @unique
  ownerId String
  postId String?
  uploadId String?
  mediaId String?
  kind FeedJobKind
  status FeedJobStatus @default(pending)
  sourceKeys String[] @default([])
  targetKeys String[] @default([])
  availableAt DateTime @default(now())
  attempts Int @default(0)
  attemptToken String? @unique
  leaseUntil DateTime?
  errorCode String? @db.VarChar(64)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status, availableAt, leaseUntil])
  @@index([ownerId, postId])
}

model FeedComment {
  moderationState String @default("visible") @db.VarChar(16)
  moderationReason String? @db.VarChar(1000)
  moderatedAt DateTime?
  id String @id @default(cuid())
  postId String
  authorId String
  text String @db.VarChar(2000)
  rootId String?
  replyToId String?
  deletedAt DateTime?
  editedAt DateTime?
  clientRequestId String @db.VarChar(64)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  post FeedPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)
  root FeedComment? @relation("FeedCommentRoot", fields: [rootId], references: [id], onDelete: SetNull)
  rootedReplies FeedComment[] @relation("FeedCommentRoot")
  replyTo FeedComment? @relation("FeedCommentReplyTo", fields: [replyToId], references: [id], onDelete: SetNull)
  addressedReplies FeedComment[] @relation("FeedCommentReplyTo")
  reactions FeedCommentReaction[]
  notifications FeedNotification[]
  @@unique([authorId, clientRequestId])
  @@index([postId, rootId, createdAt, id])
  @@index([replyToId])
}

model FeedPostReaction {
  id String @id @default(cuid())
  postId String
  userId String
  kind FeedReactionKind
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  post FeedPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([postId, userId])
  @@index([postId, kind, createdAt, id])
}

model FeedCommentReaction {
  id String @id @default(cuid())
  commentId String
  userId String
  kind FeedReactionKind
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  comment FeedComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([commentId, userId])
  @@index([commentId, kind, createdAt, id])
}

model FeedPostView {
  postId String
  userId String
  createdAt DateTime @default(now())
  post FeedPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([postId, userId])
  @@index([postId])
}

/// Opt-in signals are controlled by the viewer, not by the content author.
model FeedPersonalizationPreference {
  userId String @id
  enabled Boolean @default(true)
  useCity Boolean @default(true)
  usePets Boolean @default(true)
  useBehavior Boolean @default(true)
  exploration Boolean @default(true)
  historyResetAt DateTime?
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Qualified exposures are separate from the lifetime FeedPostView counter.
model FeedImpression {
  id String @id @default(cuid())
  eventId String @unique @db.VarChar(64)
  userId String
  postId String
  rankingSessionId String @db.VarChar(64)
  algorithmVersion String @db.VarChar(64)
  rank Int
  visibleMs Int @default(0)
  features Json?
  candidateSources String[] @default([])
  modelVersion String? @db.VarChar(64)
  experimentVariant String? @db.VarChar(16)
  occurredAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post FeedPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  @@unique([userId, postId, rankingSessionId])
  @@index([userId, occurredAt(sort: Desc)])
  @@index([postId, occurredAt(sort: Desc)])
  @@index([rankingSessionId])
}

/// Validated event tied to an immutable server-issued feed exposure.
model FeedRankingEvent {
  eventId String @id @db.VarChar(64)
  userId String
  postId String
  rankingSessionId String @db.VarChar(64)
  kind String @db.VarChar(32)
  durationMs Int @default(0)
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post FeedPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  @@index([userId, createdAt(sort: Desc)])
  @@index([postId, createdAt(sort: Desc)])
  @@index([rankingSessionId])
}

model FeedPostStats {
  postId String @id
  reactionCount Int @default(0)
  uniqueCommenterCount Int @default(0)
  bookmarkCount Int @default(0)
  uniqueViewCount Int @default(0)
  qualifiedImpressionCount Int @default(0)
  updatedAt DateTime @updatedAt
  post FeedPost @relation(fields: [postId], references: [id], onDelete: Cascade)
}

model FeedUserAuthorAffinity {
  userId String
  authorId String
  score Float @default(0)
  reactionCount Int @default(0)
  commentCount Int @default(0)
  bookmarkCount Int @default(0)
  qualifiedViewCount Int @default(0)
  lastInteractionAt DateTime?
  updatedAt DateTime @updatedAt
  viewer User @relation("FeedAffinityViewer", fields: [userId], references: [id], onDelete: Cascade)
  author User @relation("FeedAffinityAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  @@id([userId, authorId])
  @@index([userId, score(sort: Desc)])
}

model FeedUserPostFeedback {
  userId String
  postId String
  kind String @db.VarChar(32)
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post FeedPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  @@id([userId, postId, kind])
  @@index([postId])
}

/// Offline-trained artifact; deployment requires manual promotion.
model FeedSmartRankerModel {
  id String @id @default(cuid())
  version String @unique @db.VarChar(64)
  artifact Json
  active Boolean @default(false)
  trainedAt DateTime
  trainRows Int
  validationRows Int
  createdAt DateTime @default(now())
  @@index([active, trainedAt(sort: Desc)])
}

model FeedNotification {
  id String @id @default(cuid())
  recipientId String
  postId String
  commentId String?
  kind FeedNotificationKind
  groupKey String? @db.VarChar(255)
  actorIds String[] @default([])
  reaction FeedReactionKind?
  readAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  recipient User @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  post FeedPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  comment FeedComment? @relation(fields: [commentId], references: [id], onDelete: SetNull)
  @@index([recipientId, readAt, createdAt(sort: Desc), id(sort: Desc)])
  @@index([groupKey, createdAt])
}

// Delivery jobs are independent of recipient rows and allow idempotent recovery.
model FeedNotificationOutbox {
  id String @id @default(cuid())
  notificationId String
  recipientId String
  availableAt DateTime @default(now())
  status FeedJobStatus @default(pending)
  attempts Int @default(0)
  leaseUntil DateTime?
  attemptToken String? @unique
  lastErrorCode String? @db.VarChar(64)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([notificationId])
  @@index([status, availableAt, leaseUntil])
}

model FeedBookmark {
  userId String
  postId String
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post FeedPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  @@id([userId, postId])
  @@index([userId, createdAt(sort: Desc), postId(sort: Desc)])
}

model FeedAuthorPreference {
  userId String
  authorId String
  hidden Boolean @default(false)
  notify Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation("FeedPreferenceReader", fields: [userId], references: [id], onDelete: Cascade)
  author User @relation("FeedPreferenceAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  @@id([userId, authorId])
  @@index([authorId, notify, hidden])
}

// Text evidence deliberately survives author edits/deletion and has no media copies.
model FeedReport {
  id String @id @default(cuid())
  reporterId String
  authorId String
  targetType String @db.VarChar(16)
  targetId String
  postId String
  snapshotText String @db.VarChar(5000)
  reason String @db.VarChar(64)
  comment String @default("") @db.VarChar(1000)
  status String @default("pending") @db.VarChar(16)
  resolution String? @db.VarChar(16)
  resolutionReason String? @db.VarChar(1000)
  moderatorId String?
  resolvedAt DateTime?
  createdAt DateTime @default(now())
  @@unique([reporterId, targetType, targetId])
  @@index([status, createdAt(sort: Desc), id(sort: Desc)])
  @@index([authorId])
}

model FeedModerationAction {
  id String @id @default(cuid())
  moderatorId String
  reportId String
  action String @db.VarChar(16)
  reason String @db.VarChar(1000)
  createdAt DateTime @default(now())
  @@index([reportId, createdAt])
}

// Provider acceptance is distinct from delivery; event history is append-only.
model TransactionalMailAttempt {
  id                String   @id @default(cuid())
  providerMessageId String?  @unique
  recipientCount    Int
  status            String   @default("PENDING")
  errorCode         String?
  createdAt         DateTime @default(now())
  acceptedAt        DateTime?

  @@index([createdAt])
}

model TransactionalMailEvent {
  id                String   @id
  providerMessageId String
  type              String
  occurredAt        DateTime
  receivedAt        DateTime @default(now())
  errorCode         String?

  @@index([providerMessageId, occurredAt])
}
