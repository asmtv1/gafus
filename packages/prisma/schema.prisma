/// Short-lived server-side context for the VK callback → consent → NextAuth flow.
/// The opaque token itself never reaches the database; only its SHA-256 digest does.
model VkIdOneTimeLogin {
  id String @id @default(cuid())
  tokenHash String @unique @db.VarChar(64)
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  requiresConsent Boolean @default(false)
  consentCompletedAt DateTime?
  consumedAt DateTime?
  createdAt DateTime @default(now())

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

/// Idempotency record for credential registration. Password is deliberately absent:
/// a retry must verify it independently against the resulting user account.
model RegistrationEmailAttempt {
  id String @id @default(cuid())
  tempSessionId String @unique @db.VarChar(128)
  dataFingerprint String @db.VarChar(64)
  userId String?
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  result RegistrationEmailAttemptResult?
  completedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([dataFingerprint])
  @@index([userId])
}

/// Server-side OAuth/registration state. The browser sees only an opaque token;
/// state is verified by hash and the PKCE verifier never enters a URL or cookie.
model VkRegistrationContext {
  id String @id @default(cuid())
  contextTokenHash String @unique @db.VarChar(64)
  stateHash String @unique @db.VarChar(64)
  codeVerifier String @db.VarChar(128)
  purpose VkRegistrationContextPurpose
  expiresAt DateTime
  selectedPromoCodeId String?
  /// Normalized selection survives promo deletion so completion can reject it.
  selectedPromoCodeValue String? @db.VarChar(128)
  selectedPromoCode AppSubscriptionPromoCode? @relation("VkRegistrationContextSelectedPromoCode", fields: [selectedPromoCodeId], references: [id], onDelete: SetNull)
  userId String?
  user User? @relation("VkRegistrationContextUser", fields: [userId], references: [id], onDelete: SetNull)
  resultUserId String?
  resultUser User? @relation("VkRegistrationContextResultUser", fields: [resultUserId], references: [id], onDelete: SetNull)
  loginGrants VkLoginGrant[]
  completionFingerprint String? @db.VarChar(64)
  completedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([expiresAt])
  @@index([userId, expiresAt])
  @@index([resultUserId])
  @@index([completionFingerprint])
  @@index([selectedPromoCodeId])
}

/// Replacement for legacy VkIdOneTimeLogin tokens. Each opaque grant is hashed,
/// short-lived and consumed atomically; reissue creates a different row/token.
model VkLoginGrant {
  id String @id @default(cuid())
  tokenHash String @unique @db.VarChar(64)
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose VkLoginGrantPurpose
  expiresAt DateTime
  consentCompletedAt DateTime?
  consumedAt DateTime?
  reissuedFromId String?
  registrationContextId String?
  registrationContext VkRegistrationContext? @relation(fields: [registrationContextId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@index([userId, expiresAt])
  @@index([expiresAt])
  @@index([reissuedFromId])
  @@index([registrationContextId])
}

model NpdConnection {
  /// The database enforces that this singleton key is always "default".
  id String @id @default("default") @db.VarChar(32)

  inn      String @db.VarChar(12)
  deviceId String @db.VarChar(128)

  refreshTokenCipher     Bytes
  refreshTokenIv         Bytes
  refreshTokenTag        Bytes
  refreshTokenKeyVersion Int

  status                     NpdConnectionStatus @default(ACTIVE)
  fiscalizationStartedAt     DateTime?
  lastAuthorizedAt           DateTime?
  lastSuccessfulOperationAt  DateTime?
  lastRefreshedAt            DateTime?
  lastErrorCode              String?             @db.VarChar(64)
  lastErrorRedacted          String?             @db.VarChar(1024)
  createdAt                  DateTime            @default(now())
  updatedAt                  DateTime            @updatedAt

  receipts NpdReceipt[]
}

model NpdReceipt {
  id String @id @default(cuid())

  paymentId String                 @unique
  payment   AppSubscriptionPayment @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  connectionId String        @default("default") @db.VarChar(32)
  connection   NpdConnection @relation(fields: [connectionId], references: [id], onDelete: Restrict)

  status             NpdReceiptStatus @default(PENDING)
  amountKopecks      Int
  currency           String           @default("RUB") @db.VarChar(3)
  planCode           AppSubscriptionPlanCode
  intervalDays       Int
  serviceName        String           @db.VarChar(256)
  buyerEmail         String?          @db.VarChar(320)
  providerReceiptId  String?          @unique @db.VarChar(128)
  operationAt        DateTime
  printUrl           String?          @db.VarChar(2048)
  jsonUrl            String?          @db.VarChar(2048)
  issuedAt           DateTime?
  canceledAt         DateTime?
  cancellationReason String?          @db.VarChar(256)

  operations    NpdReceiptOperation[]
  emailDelivery NpdReceiptEmailDelivery?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([connectionId, status, createdAt])
  @@index([status, createdAt])
}

model NpdReceiptOperation {
  id String @id @default(cuid())

  receiptId String
  receipt   NpdReceipt                @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  type      NpdReceiptOperationType
  status    NpdReceiptOperationStatus @default(PENDING)

  attemptCount      Int       @default(0)
  lastAttemptAt     DateTime?
  nextAttemptAt     DateTime? @default(now())
  leaseOwner        String?   @db.VarChar(128)
  leaseExpiresAt    DateTime?
  providerRequestId String?   @db.VarChar(128)
  completedAt       DateTime?
  lastErrorCode     String?   @db.VarChar(64)
  lastErrorRedacted String?   @db.VarChar(1024)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([receiptId, type])
  @@index([status, nextAttemptAt, leaseExpiresAt])
  @@index([receiptId, status])
}

model NpdReceiptEmailDelivery {
  id String @id @default(cuid())

  receiptId String     @unique
  receipt   NpdReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)

  status            NpdReceiptEmailDeliveryStatus @default(PENDING)
  recipientEmail    String                        @db.VarChar(320)
  attemptCount      Int                           @default(0)
  lastAttemptAt     DateTime?
  nextAttemptAt     DateTime?                     @default(now())
  leaseOwner        String?                       @db.VarChar(128)
  leaseExpiresAt    DateTime?
  sentAt            DateTime?
  providerMessageId String?                       @db.VarChar(128)
  lastErrorCode     String?                       @db.VarChar(64)
  lastErrorRedacted String?                       @db.VarChar(1024)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, nextAttemptAt, leaseExpiresAt])
}

