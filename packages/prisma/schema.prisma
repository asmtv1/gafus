generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl", "linux-musl-openssl-3.0.x", "darwin-arm64"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// No relation to User: durable cleanup outlives all cascaded records.
model AccountStorageCleanup {
  id              String @id
  ownerId         String
  scope           String
  keys            String[] @default([])
  prefixes        String[] @default([])
  keyCursor       Int @default(0)
  status          String @default("pending")
  purgeOperations String[] @default([])
  purgeAfter      DateTime?
  attempts        Int @default(0)
  errorCode       String?
  attemptToken    String?
  leaseUntil      DateTime?
  availableAt     DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now())

  @@unique([ownerId, scope])
  @@index([status, availableAt])
}

model Course {
  id                String             @id @default(cuid())
  name              String
  type              String             @unique @db.VarChar(50)
  description       String             @default("")
  equipment         String             @default("")
  trainingLevel     TrainingLevel
  shortDesc         String             @default("")
  duration          String
  logoImg           String
  isPrivate         Boolean            @default(false)
  isPaid            Boolean            @default(false)
  authorId          String
  avgRating         Float?
  videoUrl          String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  showInProfile     Boolean            @default(true)
  priceRub          Decimal?           @db.Decimal(10, 2)
  /// Apple IAP product id (ASC non-consumable), заполняется для платных курсов в iOS
  appleIapProductId String?            @unique
  isPersonalized    Boolean            @default(false)
  guideContent      String?            @db.Text
  awards            Award[]
  author            User               @relation(fields: [authorId], references: [id])
  access            CourseAccess[]
  reviews           CourseReview[]
  surveyResponses   SurveyResponse[]
  dayLinks          DayOnCourse[]
  favoritedBy       FavoriteCourse[]
  payments          Payment[]
  userCourses       UserCourse[]
  ofertaAcceptances OfertaAcceptance[]
}

model TrainingDay {
  id                         String        @id @default(cuid())
  title                      String
  equipment                  String        @default("")
  description                String        @default("")
  type                       String        @default("regular")
  authorId                   String
  showCoursePathExport       Boolean       @default(false)
  shareProgressAcrossCourses Boolean       @default(false)
  createdAt                  DateTime      @default(now())
  updatedAt                  DateTime      @updatedAt
  dayLinks                   DayOnCourse[]
  diaryEntries               DiaryEntry[]
  stepLinks                  StepOnDay[]
  author                     User          @relation(fields: [authorId], references: [id])
}

model Step {
  id                      String                  @id @default(cuid())
  title                   String
  description             String                  @default("")
  durationSec             Int?
  type                    StepType                @default(TRAINING)
  imageUrls               String[]                @default([])
  pdfUrls                 String[]                @default([])
  videoUrl                String?
  checklist               Json?
  requiresVideoReport     Boolean                 @default(false)
  requiresWrittenFeedback Boolean                 @default(false)
  hasTestQuestions        Boolean                 @default(false)
  surveySlug              String?
  isDailyCourse           Boolean                 @default(false)
  authorId                String
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @default(now())
  estimatedDurationSec    Int?
  examResults             ExamResult[]
  surveyResponses         SurveyResponse[]
  author                  User                    @relation(fields: [authorId], references: [id])
  dailyCourseBundleLinks  DailyCourseBundleStep[]
  stepLinks               StepOnDay[]
}

model StepCategory {
  id          String         @id @default(cuid())
  name        String         @unique
  description String?
  icon        String?
  order       Int            @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  templates   StepTemplate[]

  @@index([order])
}

model StepTemplate {
  id                      String        @id @default(cuid())
  title                   String
  description             String        @default("")
  durationSec             Int?
  type                    StepType      @default(TRAINING)
  imageUrls               String[]      @default([])
  pdfUrls                 String[]      @default([])
  videoUrl                String?
  checklist               Json?
  requiresVideoReport     Boolean       @default(false)
  requiresWrittenFeedback Boolean       @default(false)
  hasTestQuestions        Boolean       @default(false)
  surveySlug              String?
  categoryId              String?
  tags                    String[]      @default([])
  isPublic                Boolean       @default(true)
  usageCount              Int           @default(0)
  authorId                String
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt
  estimatedDurationSec    Int?
  author                  User          @relation(fields: [authorId], references: [id])
  category                StepCategory? @relation(fields: [categoryId], references: [id])

  @@index([categoryId])
  @@index([isPublic])
  @@index([authorId])
}

model DayOnCourse {
  id            String         @id @default(cuid())
  courseId      String
  dayId         String
  order         Int
  course        Course         @relation(fields: [courseId], references: [id])
  day           TrainingDay    @relation(fields: [dayId], references: [id])
  userTrainings UserTraining[]

  @@unique([courseId, order])
  @@index([courseId, order])
  @@index([dayId])
}

model DiaryEntry {
  id        String      @id @default(cuid())
  userId    String
  dayId     String
  content   String
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  day       TrainingDay @relation(fields: [dayId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dayId])
  @@index([userId])
  @@index([dayId])
}

model StepOnDay {
  id        String      @id @default(cuid())
  dayId     String
  stepId    String
  order     Int
  day       TrainingDay @relation(fields: [dayId], references: [id], onDelete: Cascade)
  step      Step        @relation(fields: [stepId], references: [id], onDelete: Cascade)
  userSteps UserStep[]

  @@unique([dayId, order])
  @@index([dayId, order])
}

model DailyCourseBundle {
  id          String                  @id @default(cuid())
  title       String
  equipment   String                  @default("")
  description String                  @default("")
  type        String                  @default("regular")
  authorId    String
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  author      User                    @relation(fields: [authorId], references: [id], onDelete: Restrict)
  schedules   DailyCourseSchedule[]
  stepLinks   DailyCourseBundleStep[]

  @@index([authorId])
  @@index([updatedAt])
}

model DailyCourseBundleStep {
  id                   String                @id @default(cuid())
  bundleId             String
  stepId               String
  order                Int
  bundle               DailyCourseBundle     @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  step                 Step                  @relation(fields: [stepId], references: [id], onDelete: Cascade)
  dailyCourseUserSteps DailyCourseUserStep[]

  @@unique([bundleId, order])
  @@index([bundleId, order])
  @@index([stepId])
}

model UserTraining {
  id               String         @id @default(cuid())
  userId           String
  dayOnCourseId    String
  status           TrainingStatus @default(NOT_STARTED)
  currentStepIndex Int?           @default(0)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @default(now())
  steps            UserStep[]
  dayOnCourse      DayOnCourse    @relation(fields: [dayOnCourseId], references: [id], onDelete: Cascade)
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dayOnCourseId])
}

model UserStep {
  id             String         @id @default(cuid())
  userTrainingId String
  stepOnDayId    String
  status         TrainingStatus @default(NOT_STARTED)
  paused         Boolean        @default(false)
  remainingSec   Int?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @default(now())
  examResult     ExamResult?
  stepOnDay      StepOnDay      @relation(fields: [stepOnDayId], references: [id], onDelete: Cascade)
  userTraining   UserTraining   @relation(fields: [userTrainingId], references: [id], onDelete: Cascade)

  @@unique([userTrainingId, stepOnDayId])
}

model DailyCourseSchedule {
  id            String                    @id @default(cuid())
  date          DateTime                  @unique @db.Date
  bundleId      String
  createdById   String
  isPublished   Boolean                   @default(true)
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt
  bundle        DailyCourseBundle         @relation(fields: [bundleId], references: [id], onDelete: Restrict)
  createdBy     User                      @relation("DailyCourseSchedulesCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  userTrainings DailyCourseUserTraining[]

  @@index([date])
  @@index([bundleId])
  @@index([createdById])
}

model DailyCourseUserTraining {
  id               String                @id @default(cuid())
  userId           String
  scheduleId       String
  status           TrainingStatus        @default(NOT_STARTED)
  currentStepIndex Int?                  @default(0)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  schedule         DailyCourseSchedule   @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  user             User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  steps            DailyCourseUserStep[]

  @@unique([userId, scheduleId])
  @@index([scheduleId])
  @@index([userId])
}

model DailyCourseUserStep {
  id                        String                  @id @default(cuid())
  dailyCourseUserTrainingId String
  bundleStepId              String
  status                    TrainingStatus          @default(NOT_STARTED)
  paused                    Boolean                 @default(false)
  remainingSec              Int?
  createdAt                 DateTime                @default(now())
  updatedAt                 DateTime                @updatedAt
  dailyCourseUserTraining   DailyCourseUserTraining @relation(fields: [dailyCourseUserTrainingId], references: [id], onDelete: Cascade)
  bundleStep                DailyCourseBundleStep   @relation(fields: [bundleStepId], references: [id], onDelete: Cascade)
  examResult                ExamResult?

  @@unique([dailyCourseUserTrainingId, bundleStepId])
  @@index([dailyCourseUserTrainingId])
  @@index([bundleStepId])
}

model User {
  feedBookmarks FeedBookmark[]
  feedPostFeedback FeedUserPostFeedback[]
  feedPersonalization FeedPersonalizationPreference?
  feedImpressions FeedImpression[]
  feedRankingEvents FeedRankingEvent[]
  feedAffinitiesAsViewer FeedUserAuthorAffinity[] @relation("FeedAffinityViewer")
  feedAffinitiesAsAuthor FeedUserAuthorAffinity[] @relation("FeedAffinityAuthor")
  feedPreferences FeedAuthorPreference[] @relation("FeedPreferenceReader")
  feedSubscribers FeedAuthorPreference[] @relation("FeedPreferenceAuthor")
  feedPublishingBlocked Boolean @default(false)
  feedPublishingBlockReason String? @db.VarChar(1000)
  feedPosts FeedPost[]
  feedMediaAssets FeedMediaAsset[]
  feedUploads FeedUpload[]
  feedComments FeedComment[]
  feedPostReactions FeedPostReaction[]
  feedCommentReactions FeedCommentReaction[]
  feedPostViews FeedPostView[]
  feedNotifications FeedNotification[]
  galleryAlbums GalleryAlbum[]
  galleryPhotos GalleryPhoto[]
  galleryUploads GalleryUpload[]
  questions Question[]
  questionAnswers QuestionAnswer[]
  questionHearts QuestionHeart[]
  questionViews QuestionView[]
  questionPhotos QuestionPhoto[]
  questionReports QuestionReport[]
  questionBlock QuestionBlock?

  clientCynologistChat CynologistChat? @relation("ChatClient")
  trainerCynologistChats CynologistChat[] @relation("ChatTrainer")
  communityChatOperations CommunityChatSendOperation[]
  communityChatAttachments CommunityChatAttachment[]
  id                               String                           @id @default(cuid())
  username                         String                           @unique
  email                            String?                          @unique
  phone                            String?                          @unique
  appleAppAccountToken             String?                          @unique @db.VarChar(36)
  password                         String
  passwordSetAt                    DateTime?
  sessionsRevokedAt                DateTime?
  onboardingTourCompletedAt        DateTime?
  telegramId                       String?                          @unique
  role                             UserRole                         @default(USER)
  registrationChannel              RegistrationChannel              @default(UNKNOWN)
  passwordResetRequestedAt         DateTime?
  accountDeletionRequestedAt       DateTime?
  createdAt                        DateTime                         @default(now())
  updatedAt                        DateTime                         @default(now())
  accounts                         Account[]
  sessions                         Session[]
  authoredCourses                  Course[]
  courseAccesses                   CourseAccess[]
  courseReviews                    CourseReview[]
  diaryEntries                     DiaryEntry[]
  diplomas                         Diploma[]
  reviewedExamResults              ExamResult[]                     @relation("ExamResultReviewedBy")
  surveyResponses                  SurveyResponse[]
  favoriteCourses                  FavoriteCourse[]
  passwordResetTokens              PasswordResetToken[]
  accountDeletionTokens            AccountDeletionToken[]
  payments                         Payment[]
  pets                             Pet[]
  petDocuments                     PetDocument[]
  emailChangeTokens                EmailChangeToken[]
  pushSubscriptions                PushSubscription[]
  reengagementCampaigns            ReengagementCampaign[]
  reengagementSettings             ReengagementSettings?
  refreshTokens                    RefreshToken[]
  reminders                        Reminder[]
  createdSteps                     Step[]
  stepNotifications                StepNotification[]
  createdStepTemplates             StepTemplate[]
  trainerAIChats                   TrainerAIChat[]
  trainerAIConfig                  TrainerAIConfig?
  trainerNotes                     TrainerNote[]                    @relation("TrainerNotes")
  studentNotes                     TrainerNoteStudent[]             @relation("StudentNotes")
  trainerVideos                    TrainerVideo[]
  trainings                        Training[]
  trainingAccesses                 TrainingAccess[]
  createdDays                      TrainingDay[]
  dailyCourseBundles               DailyCourseBundle[]
  userCourses                      UserCourse[]
  profile                          UserProfile?
  userTrainings                    UserTraining[]
  userVideoProgresses              UserVideoProgress[]
  consentLogs                      ConsentLog[]
  ofertaAcceptances                OfertaAcceptance[]
  petPreventionEntries             PetPreventionEntry[]
  authoredArticles                 Article[]                        @relation("authoredArticles")
  articleLikes                     ArticleLike[]
  articleAccesses                  ArticleAccess[]
  articlePayments                  ArticlePayment[]
  articleViews                     ArticleViewer[]
  /// Профиль кинолога для консультаций (один к одному с пользователем-тренером)
  consultationCynologist           ConsultationCynologist?
  /// Бронирования консультаций как клиент
  consultationBookingsAsClient     ConsultationBooking[]
  /// Идемпотентность POST /book (ключ + клиент)
  consultationBookingIdempotency   ConsultationBookingIdempotency[]
  createdDailyCourseSchedules      DailyCourseSchedule[]            @relation("DailyCourseSchedulesCreatedBy")
  dailyCourseUserTrainings         DailyCourseUserTraining[]
  appSubscriptions                 AppSubscription[]                @relation("AppSubscriptionUser")
  appSubscriptionPayments          AppSubscriptionPayment[]         @relation("AppSubscriptionPaymentUser")
  appSubscriptionEvents            AppSubscriptionEvent[]           @relation("AppSubscriptionEventUser")
  appSubscriptionTrials            AppSubscriptionTrial[]           @relation("AppSubscriptionTrialUser")
  manualAppSubscriptionGrants      AppSubscription[]                @relation("ManualAppSubscriptionGrantedBy")
  updatedAppSubscriptionSettings   AppSubscriptionSettings[]        @relation("AppSubscriptionSettingsUpdatedBy")
  adminAppSubscriptionEvents       AppSubscriptionEvent[]           @relation("AppSubscriptionEventActor")
  createdAppSubscriptionPromoCodes AppSubscriptionPromoCode[]       @relation("AppSubscriptionPromoCodeCreatedBy")
  updatedAppSubscriptionPromoCodes AppSubscriptionPromoCode[]       @relation("AppSubscriptionPromoCodeUpdatedBy")
  appSubscriptionPromoCodeEvents   AppSubscriptionPromoCodeEvent[]  @relation("AppSubscriptionPromoCodeEventActor")
  profitVideoExpenses              ProfitVideoExpense[]
  partnerProfile                   PartnerProfile?
  referredByPartner                PartnerReferral?                 @relation("PartnerReferralBuyer")
  savedRegistrationPromoCodeId     String?
  savedRegistrationPromoCode       AppSubscriptionPromoCode?       @relation("UserSavedRegistrationPromoCode", fields: [savedRegistrationPromoCodeId], references: [id], onDelete: SetNull)
  registrationEmailAttempts        RegistrationEmailAttempt[]
  vkRegistrationContexts           VkRegistrationContext[]          @relation("VkRegistrationContextUser")
  vkRegistrationResults            VkRegistrationContext[]          @relation("VkRegistrationContextResultUser")
  vkLoginGrants                    VkLoginGrant[]
  rewardedCreditWallet             RewardedCreditWallet?
  gafusWallet                      GafusWallet?
  gafusTransactions                GafusTransaction[]
  gafusTransactionsAsAdmin         GafusTransaction[]             @relation("GafusTransactionAdminActor")
  gafusRewardEvents                GafusRewardEvent[]
  gafusTargetAccesses              GafusTargetAccess[]
  gafusSettingsUpdated             GafusSettings[]                @relation("GafusSettingsUpdatedBy")
  gafusSettingsRevisions            GafusSettingsRevision[]        @relation("GafusSettingsRevisionActor")
  gafusAdminAudits                  GafusAdminAudit[]              @relation("GafusAdminAuditActor")
  rewardedAdSessions               RewardedAdSession[]
  rewardedTargetAccesses           RewardedTargetAccess[]
  vkIdOneTimeLogins                VkIdOneTimeLogin[]
  rewardedCreditTransactions       RewardedCreditTransaction[]
  updatedRewardedAdSettings        RewardedAdSettings[]
  updatedMobileAppReleasePolicies  MobileAppReleasePolicy[]         @relation("MobileAppReleasePolicyUpdatedBy")
  mobileIntroAuthOutcomes          MobileIntroInstallation[]        @relation("MobileIntroAuthOutcomeUser")

  /// False for every existing account. Set only while a VK registration still awaits consent.
  registrationPending              Boolean                          @default(false)

  @@index([savedRegistrationPromoCodeId])
}

enum MobileIntroPlatform {
  IOS
  ANDROID
}

enum MobileIntroCompletion {
  COMPLETED
  SKIPPED
}

enum MobileIntroAuthOutcome {
  REGISTERED
  LOGGED_IN
}

/// One first-run mobile introduction per anonymous installation and introduction version.
/// The installation id is generated by the app and is never a user id or device fingerprint.
model MobileIntroInstallation {
  id                 String                    @id @default(cuid())
  installationId     String                    @db.VarChar(128)
  introVersion       String                    @db.VarChar(32)
  platform           MobileIntroPlatform
  openedAt           DateTime
  receivedAt         DateTime                  @default(now())
  completion         MobileIntroCompletion?
  completedAt        DateTime?
  authOutcome        MobileIntroAuthOutcome?
  authOutcomeAt      DateTime?
  authOutcomeUserId  String?
  authOutcomeUser    User?                     @relation("MobileIntroAuthOutcomeUser", fields: [authOutcomeUserId], references: [id], onDelete: SetNull)
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt

  @@unique([installationId, introVersion])
  @@index([openedAt])
  @@index([authOutcomeUserId])
}

enum ConsentType {
  PERSONAL_DATA
  PRIVACY_POLICY
  DATA_DISTRIBUTION
}

enum ConsentLogStatus {
  PENDING
  COMPLETED
  FAILED
}

model ConsentLog {
  id             String           @id @default(cuid())
  tempSessionId  String
  consentType    ConsentType
  userId         String?
  user           User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  consentVersion String
  consentText    Json?
  consentDate    DateTime
  ipAddress      String?
  userAgent      String?
  formData       Json?
  status         ConsentLogStatus
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([tempSessionId, consentType])
  @@index([userId])
  @@index([createdAt])
  @@index([status])
  @@index([tempSessionId])
}

model TrainerVideo {
  id                  String              @id @default(cuid())
  trainerId           String
  relativePath        String
  originalName        String
  mimeType            String
  fileSize            BigInt
  durationSec         Int?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @default(now()) @updatedAt
  displayName         String?
  hlsManifestPath     String?
  transcodingStatus   TranscodingStatus   @default(PENDING)
  transcodedAt        DateTime?
  transcodingError    String?
  thumbnailPath       String?
  trainer             User                @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  userVideoProgresses UserVideoProgress[]

  @@index([trainerId], map: "idx_trainer_videos_trainer")
  @@index([transcodingStatus])
}

model UserVideoProgress {
  id              String       @id @default(cuid())
  userId          String
  videoId         String
  lastPositionSec Int
  updatedAt       DateTime     @updatedAt
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  video           TrainerVideo @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([userId, videoId])
  @@index([userId])
  @@index([videoId])
}

model UserProfile {
  id        String    @id @default(cuid())
  userId    String    @unique
  fullName  String?
  city      String?
  cityKey   String?   @db.VarChar(160)
  birthDate DateTime?
  about     String?
  telegram  String?
  instagram String?
  website   String?
  avatarUrl String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([cityKey])
}

model Diploma {
  id        String    @id @default(cuid())
  userId    String
  title     String
  issuedBy  String?
  issuedAt  DateTime?
  url       String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Training {
  id        String           @id @default(cuid())
  userId    String
  name      String
  isPrivate Boolean          @default(false)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  access    TrainingAccess[]
}

model UserCourse {
  userId          String
  courseId        String
  status          TrainingStatus @default(NOT_STARTED)
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @default(now())
  userDisplayName String?
  userGender      String?
  petName         String?
  petNameDat      String?
  petNameIns      String?
  petGender       String?
  petNameGen      String?
  petNameAcc      String?
  petNamePre      String?
  course          Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, courseId])
}

model Pet {
  id                String               @id @default(cuid())
  ownerId           String
  name              String
  type              PetType
  breed             String
  breedKey          String?              @db.VarChar(160)
  birthDate         DateTime
  heightCm          Float?
  weightKg          Float?
  targetWeightKg    Float?
  neckGirthCm       Float?
  muzzleGirthCm     Float?
  bellyGirthCm      Float?
  photoUrl          String?
  showInProfile     Boolean              @default(true)
  notes             String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @default(now())
  awards            Award[]
  documents         PetDocument[]        @relation("PetDocumentsByOwner")
  owner             User                 @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  preventionEntries PetPreventionEntry[]
  weightEntries     PetWeightEntry[]
  vetVisits         PetVetVisit[]
  surveyResponses   SurveyResponse[]

  @@unique([id, ownerId])
  @@index([breedKey])
}

model PetVetVisit {
  id          String @id @default(cuid())
  petId       String
  ownerId     String
  visitedOn   DateTime @db.Date
  specialty   String @db.VarChar(200)
  doctorName  String @default("") @db.VarChar(200)
  clinic      String @default("") @db.VarChar(300)
  diagnosis   String @default("")
  conclusion  String @default("")
  notes       String @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  pet         Pet @relation(fields: [petId, ownerId], references: [id, ownerId], onDelete: Cascade)
  attachments PetVetAttachment[]

  @@index([petId, visitedOn, createdAt])
  @@index([ownerId])
}

model PetVetAttachment {
  id          String @id @default(cuid())
  visitId     String
  name        String @db.VarChar(200)
  mimeType    String
  sizeBytes   Int
  originalKey String @unique
  previewKey  String? @unique
  createdAt   DateTime @default(now())
  visit       PetVetVisit @relation(fields: [visitId], references: [id], onDelete: Cascade)

  @@index([visitId, createdAt])
}

model PetWeightEntry {
  id         String   @id @default(cuid())
  petId      String
  ownerId    String
  weightKg   Float
  measuredAt DateTime
  createdAt  DateTime @default(now())
  pet        Pet      @relation(fields: [petId, ownerId], references: [id, ownerId], onDelete: Cascade)

  @@index([petId, measuredAt])
  @@index([ownerId])
}

model PetDocument {
  id        String   @id @default(cuid())
  petId     String
  ownerId   String
  name      String
  mimeType  String
  sizeBytes Int
  url       String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  pet       Pet      @relation("PetDocumentsByOwner", fields: [petId, ownerId], references: [id, ownerId], onDelete: Cascade)
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([petId, createdAt])
  @@index([ownerId])
}

model Award {
  id        String    @id @default(cuid())
  petId     String
  title     String
  event     String?
  date      DateTime?
  rank      String?
  examType  String?
  examScore Int?
  courseId  String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now())
  course    Course?   @relation(fields: [courseId], references: [id])
  pet       Pet       @relation(fields: [petId], references: [id], onDelete: Cascade)

  @@index([petId])
  @@index([courseId])
}

model PetPreventionEntry {
  id                      String                    @id @default(cuid())
  petId                   String
  ownerId                 String
  type                    PetPreventionType
  performedAt             DateTime
  productName             String?
  notes                   String?
  clientId                String?
  /// Включено ли push-напоминание по этой записи
  reminderEnabled         Boolean                   @default(true)
  /// Способ задания даты напоминания: через N дней после выполненного или фиксированная дата
  reminderKind            PetPreventionReminderKind @default(AFTER_DAYS)
  /// Интервал в днях после performedAt (только при reminderKind = AFTER_DAYS)
  reminderDaysAfter       Int?
  /// Календарная дата напоминания (только при reminderKind = ON_DATE), хранится как date
  reminderOnDate          DateTime?                 @db.Date
  /// Вычисленный день срабатывания напоминания (для выборки воркером)
  remindAt                DateTime?                 @db.Date
  /// JSON-массив времён напоминания ["09:00","21:00"]; по умолчанию ["09:00"]
  reminderTimes           Json                      @default("[\"09:00\"]")
  /// Дата remindAt, по которой уже успешно отправили push (идемпотентность повторных прогонов)
  lastNotifiedForRemindAt DateTime?                 @db.Date
  /// Какие времена из reminderTimes уже отправлены для текущего remindAt (JSON массив строк)
  sentTimesForRemindAt    Json?
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt
  pet                     Pet                       @relation(fields: [petId], references: [id], onDelete: Cascade)
  owner                   User                      @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@unique([petId, clientId])
  @@index([petId])
  @@index([ownerId])
  @@index([petId, type, performedAt])
  @@index([reminderEnabled, remindAt])
}

