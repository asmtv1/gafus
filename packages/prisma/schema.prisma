model Article {
  id          String             @id @default(cuid())
  authorId    String
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  title       String
  contentType ArticleContentType @default(HTML)
  content     String             @db.Text
  visibility  ArticleVisibility  @default(PUBLIC)
  priceRub    Decimal?           @db.Decimal(10, 2)
  videoUrl    String?
  logoImg     String             @default("")
  imageUrls   String[]           @default([])
  slug        String             @unique
  viewCount   Int                @default(0)
  description String             @default("") @db.Text

  author       User               @relation("authoredArticles", fields: [authorId], references: [id])
  articleLikes ArticleLike[]
  access       ArticleAccess[]
  payments     ArticlePayment[]
  viewers      ArticleViewer[]
  guestViews   ArticleGuestView[]

  @@index([authorId])
  @@index([createdAt])
  @@index([visibility])
}

