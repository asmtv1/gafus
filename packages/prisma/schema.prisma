  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  article           Article       @relation(fields: [articleId], references: [id], onDelete: Cascade)
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([articleId])
  @@index([status])
}

/// Публичные флаги клиентов (мобильное приложение и т.д.). Ключ — стабильный идентификатор.
model AppFeatureFlag {
  key       String   @id @db.VarChar(64)
  enabled   Boolean  @default(false)
  updatedAt DateTime @updatedAt
}

// --- Консультации с кинологом (web + mobile) ---

enum ConsultationSlotStatus {
  FREE
  BOOKED
  BLOCKED
}

enum ConsultationBookingStatus {
  PENDING_TRAINER_CONFIRMATION
  CONFIRMED
  CANCELLED_BY_TRAINER
  CANCELLED_BY_USER
  CANCELLED_BY_SLA
  CANCELLED_BY_SYSTEM
  COMPLETED
  NO_SHOW
}

enum ConsultationPetGender {
  MALE
  FEMALE
}

enum ConsultationEmailType {
  TRAINER_CONFIRM_REQUEST
  CLIENT_BOOKING_RECEIVED
  CLIENT_BOOKING_CONFIRMED
  TRAINER_BOOKING_CONFIRMED
  CLIENT_BOOKING_CANCELLED_BY_TRAINER
  TRAINER_BOOKING_CANCELLED_BY_USER
  CLIENT_BOOKING_CANCELLED_BY_SLA
  /// Телемост не создался при записи, бронь снята системой
  CLIENT_BOOKING_TELEMOST_FAILED
  /// Напоминание за 30 минут (клиент)
  CLIENT_CONSULTATION_REMINDER_30M
  /// Клиенту: консультация начинается прямо сейчас
  CLIENT_CONSULTATION_START
  /// Напоминание за 30 минут (кинолог)
  TRAINER_CONSULTATION_REMINDER_30M
  /// Клиенту: тренер отметил, что подтверждённая консультация не состоялась
  CLIENT_CONSULTATION_NO_SHOW
}

enum ConsultationEmailStatus {
  PENDING
  SENT
  FAILED
}

/// Настройки кинолога для консультаций (роль TRAINER проверяется в core)
model ConsultationCynologist {
  id                 String   @id @default(cuid())
  userId             String   @unique
  isListed           Boolean  @default(false)
  telemostHostEmail  String?
  slotDurationMin    Int      @default(30)
  timezone           String   @default("Europe/Moscow")
  bookingLeadTimeMin Int      @default(60)
  slotHorizonDays    Int      @default(60)
  confirmationSlaMin Int      @default(120)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user              User                           @relation(fields: [userId], references: [id], onDelete: Cascade)
  availabilityRules ConsultationAvailabilityRule[]
  dayOffs           ConsultationDayOff[]
  slotExceptions    ConsultationSlotException[]
  slots             ConsultationSlot[]
  bookings          ConsultationBooking[]

  @@index([isListed])
}

model ConsultationAvailabilityRule {
  id           String   @id @default(cuid())
  cynologistId String
  weekday      Int
  startTime    String
  endTime      String
  isWorkingDay Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  cynologist ConsultationCynologist @relation(fields: [cynologistId], references: [id], onDelete: Cascade)

  @@unique([cynologistId, weekday])
  @@index([cynologistId])
}

model ConsultationDayOff {
  id           String   @id @default(cuid())
  cynologistId String
  date         DateTime @db.Date
  reason       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  cynologist ConsultationCynologist @relation(fields: [cynologistId], references: [id], onDelete: Cascade)

  @@unique([cynologistId, date])
  @@index([cynologistId])
}

model ConsultationSlotException {
  id           String   @id @default(cuid())
  cynologistId String
  startAt      DateTime
  endAt        DateTime
  reason       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  cynologist ConsultationCynologist @relation(fields: [cynologistId], references: [id], onDelete: Cascade)

  @@index([cynologistId, startAt])
}

model ConsultationSlot {
  id           String                 @id @default(cuid())
  cynologistId String
  startAt      DateTime
  endAt        DateTime
  status       ConsultationSlotStatus @default(FREE)
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  cynologist ConsultationCynologist @relation(fields: [cynologistId], references: [id], onDelete: Cascade)
  bookings   ConsultationBooking[]

  @@unique([cynologistId, startAt])
  @@index([cynologistId, status, startAt])
}

model ConsultationBooking {
  id                     String                    @id @default(cuid())
  clientId               String
  cynologistId           String
  slotId                 String
  /// Имя владельца (как указано при записи)
  clientOwnerName        String?
  /// Телефон для связи, E.164 (+7…)
  clientPhone            String?
  petName                String?
  petGender              ConsultationPetGender?
  petAge                 String?
  petBreed               String?
  clientProblem          String?
  /// Как пытались решить проблему самостоятельно
  clientSelfHelpAttempt  String?
  status                 ConsultationBookingStatus @default(PENDING_TRAINER_CONFIRMATION)
  telemostConferenceId   String?
  telemostJoinUrl        String?
  telemostWatchUrl       String?
  trainerConfirmedAt     DateTime?
  cancelReason           String?
  confirmationDeadlineAt DateTime
  createdAt              DateTime                  @default(now())
  updatedAt              DateTime                  @updatedAt

  client     User                   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  cynologist ConsultationCynologist @relation(fields: [cynologistId], references: [id], onDelete: Cascade)
  slot       ConsultationSlot       @relation(fields: [slotId], references: [id], onDelete: Restrict)
  emailLogs  ConsultationEmailLog[]

  @@index([slotId])
  @@index([cynologistId, status])
  @@index([clientId, createdAt])
}

model ConsultationEmailLog {
  id        String                  @id @default(cuid())
  bookingId String
  type      ConsultationEmailType
  status    ConsultationEmailStatus @default(PENDING)
  attempts  Int                     @default(0)
  lastError String?
  sentAt    DateTime?
  createdAt DateTime                @default(now())
  updatedAt DateTime                @updatedAt

  booking ConsultationBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@unique([bookingId, type])
  @@index([bookingId, type])
}

model ConsultationBookingIdempotency {
  clientId     String
  key          String
  bookingId    String?
  responseJson Json
  expiresAt    DateTime

  client User @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@id([clientId, key])
  @@index([expiresAt])
}
