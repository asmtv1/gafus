{
  "name": "@gafus/media-shared",
  "version": "1.7.3",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./media-db-ports": {
      "types": "./dist/mediaDbPorts.d.ts",
      "default": "./dist/mediaDbPorts.js"
    },
    "./purge-paths": {
      "types": "./dist/deletedMediaPurgePaths.d.ts",
      "default": "./dist/deletedMediaPurgePaths.js"
    }
  },
  "scripts": {
    "build": "tsc && ts-add-js-extension --dir dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@gafus/prisma": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "20.4.8",
    "typescript": "5.8.3",
    "ts-add-js-extension": "^1.6.6",
    "vitest": "4.1.0"
  },
  "typesVersions": {
    "*": {
      "media-db-ports": [
        "dist/mediaDbPorts.d.ts"
      ],
      "purge-paths": [
        "dist/deletedMediaPurgePaths.d.ts"
      ]
    }
  }
}
