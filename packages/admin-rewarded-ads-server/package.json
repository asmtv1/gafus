{
  "name": "@gafus/admin-rewarded-ads-server",
  "version": "1.7.2",
  "private": true,
  "sideEffects": true,
  "type": "module",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "adminRewardedAdsService": ["dist/adminRewardedAdsService.d.ts"],
      "types": ["dist/types.d.ts"]
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./adminRewardedAdsService": {
      "types": "./dist/adminRewardedAdsService.d.ts",
      "default": "./dist/adminRewardedAdsService.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "default": "./dist/types.js"
    }
  },
  "scripts": {
    "build": "tsc && ts-add-js-extension --dir dist",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@gafus/prisma": "workspace:*",
    "luxon": "^3.7.2"
  },
  "devDependencies": {
    "@types/node": "20.4.8",
    "typescript": "5.8.3",
    "ts-add-js-extension": "^1.6.6",
    "@types/luxon": "^3.7.1"
  }
}
