{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2023",
      "DOM"
    ],
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "types": [
      "node"
    ],
    "tsBuildInfoFile": "./dist/tsconfig.tsbuildinfo",
    "baseUrl": "../..",
    "paths": {
      "@gafus/prisma": [
        "packages/prisma/dist/index.d.ts"
      ],
      "@gafus/types": [
        "packages/types/dist/index.d.ts"
      ],
      "@gafus/logger": [
        "packages/logger/dist/index.d.ts"
      ],
      "@gafus/subscription-finance-server/payment-finance": [
        "packages/subscription-finance-server/dist/paymentFinance.d.ts"
      ],
      "@gafus/subscription-finance-server/partner-rows": [
        "packages/subscription-finance-server/dist/partnerRows.d.ts"
      ],
      "@gafus/subscription-finance-server/npd-receipts": [
        "packages/subscription-finance-server/dist/npdReceipts.d.ts"
      ],
      "@gafus/subscription-trial-server/trial-usage": [
        "packages/subscription-trial-server/dist/trialUsage.d.ts"
      ],
      "@gafus/subscription-read-server": [
        "packages/subscription-read-server/dist/index.d.ts"
      ],
      "@gafus/feature-flags-server/appFeatureFlagsService": [
        "packages/feature-flags-server/dist/appFeatureFlagsService.d.ts"
      ]
    }
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "src/**/*.test.ts"
  ]
}
