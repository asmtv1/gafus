{
  "name": "@gafus/logger",
  "version": "1.7.3",
  "description": "Единый логгер для всех приложений Gafus с интеграцией в error-dashboard",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "clean": "rimraf dist",
    "dev": "tsc --watch"
  },
  "dependencies": {
    "@opentelemetry/api": "1.9.0",
    "@opentelemetry/context-async-hooks": "2.2.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.208.0",
    "@opentelemetry/resources": "2.2.0",
    "@opentelemetry/sdk-trace-base": "2.2.0",
    "pino": "^9.0.0",
    "pino-pretty": "^11.0.0"
  },
  "devDependencies": {
    "@types/node": "20.4.8",
    "rimraf": "5.0.1",
    "typescript": "5.8.3"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server-telemetry": {
      "types": "./dist/serverTelemetry.d.ts",
      "default": "./dist/serverTelemetry.js"
    }
  },
  "typesVersions": {
    "*": {
      "server-telemetry": [
        "dist/serverTelemetry.d.ts"
      ]
    }
  }
}
