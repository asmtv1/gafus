{
  "name": "@gafus/questions-server",
  "version": "1.7.3",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./notifications": {
      "types": "./dist/notifications.d.ts",
      "default": "./dist/notifications.js"
    },
    "./photos": {
      "types": "./dist/photos.d.ts",
      "default": "./dist/photos.js"
    },
    "./service": {
      "types": "./dist/service.d.ts",
      "default": "./dist/service.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@gafus/core": "workspace:*",
    "@gafus/types": "workspace:*",
    "zod": "^3.25.56",
    "@gafus/queues": "workspace:*",
    "@gafus/prisma": "workspace:*",
    "@gafus/cdn-upload": "workspace:*",
    "@gafus/media-server": "workspace:*",
    "@gafus/questions-write-server": "workspace:*",
    "@gafus/questions-shared": "workspace:*",
    "@gafus/gafus-server": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "20.4.8",
    "typescript": "5.8.3",
    "vitest": "^4.0.17"
  }
}
