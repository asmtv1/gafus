{
  "name": "@gafus/feed-server",
  "version": "1.7.3",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./storage-jobs": {
      "types": "./dist/storageJobs.d.ts",
      "default": "./dist/storageJobs.js"
    },
    "./account-cleanup": {
      "types": "./dist/cleanupRows.d.ts",
      "default": "./dist/cleanupRows.js"
    },
    "./smart-persistence": {
      "types": "./dist/smart-persistence.d.ts",
      "default": "./dist/smart-persistence.js"
    },
    "./retired-photo-queue": {
      "types": "./dist/retiredPhotoQueue.d.ts",
      "default": "./dist/retiredPhotoQueue.js"
    },
    "./runtime-services": {
      "types": "./dist/runtimeServices.d.ts",
      "default": "./dist/runtimeServices.js"
    },
    "./background-operations": {
      "types": "./dist/backgroundOperations.d.ts",
      "default": "./dist/backgroundOperations.js"
    },
    "./gafus-reaction-progress": {
      "types": "./dist/gafusReactionProgress.d.ts",
      "default": "./dist/gafusReactionProgress.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@gafus/core": "workspace:*",
    "@gafus/prisma": "workspace:*",
    "@gafus/types": "workspace:*",
    "@gafus/feed-cloud": "workspace:*",
    "@gafus/queues": "workspace:*",
    "zod": "^3.25.56",
    "@gafus/feed-storage": "workspace:*",
    "@gafus/media-server": "workspace:*",
    "@gafus/media-shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "20.4.8",
    "typescript": "5.8.3",
    "vitest": "4.1.0"
  }
}
