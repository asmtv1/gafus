{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    "pnpm-lock.yaml",
    ".env",
    ".env.local",
    ".env.development",
    ".env.production",
    "tests/config/vitest/**",
    "tests/support/**",
    "tests/catalog/**",
    "scripts/qa/test-system.mjs",
    "scripts/qa/test-inventory.mjs",
    "tsconfig.base.json"
  ],
  "globalEnv": [
    "NODE_ENV",
    "DATABASE_URL",
    "NEXT_RUNTIME",
    "NEXT_PUBLIC_APP_URL",
    "NEXT_PUBLIC_YM_COUNTER_ID",
    "NEXT_PUBLIC_GAFUS_ANALYTICS_DEBUG",
    "GAFUS_PRIVATE_MAPS_ENABLED",
    "GAFUS_PRIVATE_MAPS_DIR",
    "GAFUS_RELEASE_SHA",
    "VITE_GAFUS_BUILD_ID",
    "CI"
  ],
  "tasks": {
    "clean": {
      "cache": false
    },
    "build": {
      "dependsOn": [
        "^build",
        "prisma:generate"
      ],
      "outputs": [
        ".next/**",
        "dist/**",
        "build/**",
        "coverage/**"
      ],
      "inputs": [
        "src/**",
        "public/**",
        "package.json",
        "tsconfig*.json",
        "next.config.*",
        "tsup.config.*",
        "postcss.config.*",
        "tailwind.config.*",
        "prisma/**",
        "schema.prisma"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": [
        "prisma:generate"
      ],
      "inputs": [
        "src/**",
        "public/**",
        "package.json",
        "tsconfig*.json",
        "next.config.*"
      ]
    },
    "lint": {
      "outputs": [],
      "inputs": [
        "**/*.{js,ts,tsx,mjs,cjs}",
        "eslint.config.*",
        ".eslintrc.*",
        "tsconfig*.json",
        "package.json"
      ]
    },
    "lint:fix": {
      "outputs": [],
      "inputs": [
        "**/*.{js,ts,tsx,mjs,cjs}",
        "eslint.config.*",
        ".eslintrc.*",
        "tsconfig*.json",
        "package.json"
      ]
    },
    "typecheck": {
      "outputs": [],
      "dependsOn": [
        "^build",
        "prisma:generate"
      ],
      "inputs": [
        "src/**",
        "types/**",
        "tsconfig*.json",
        "package.json",
        "app/**"
      ]
    },
    "test": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "coverage/**",
        "junit.xml"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/tests/config/**",
        "$TURBO_ROOT$/tests/support/**",
        "$TURBO_ROOT$/tests/catalog/**",
        "$TURBO_ROOT$/scripts/qa/**",
        "src/**",
        "tests/**",
        "test/**",
        "**/*.{test,spec}.{js,ts,tsx}",
        "vitest.config.*",
        "vite.config.*",
        "jest.config.*",
        "package.json"
      ]
    },
    "test:coverage": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "coverage/**"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/tests/config/**",
        "$TURBO_ROOT$/tests/support/**",
        "$TURBO_ROOT$/tests/catalog/**",
        "$TURBO_ROOT$/scripts/qa/**",
        "src/**",
        "tests/**",
        "test/**",
        "**/*.{test,spec}.{js,ts,tsx}",
        "vitest.config.*",
        "package.json"
      ]
    },
    "test:watch": {
      "cache": false,
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "src/**",
        "tests/**",
        "test/**",
        "**/*.{test,spec}.{js,ts,tsx}",
        "vitest.config.*",
        "package.json"
      ]
    },
    "start": {
      "cache": false,
      "persistent": true,
      "dependsOn": [
        "build"
      ]
    },
    "prisma:generate": {
      "cache": false,
      "outputs": [],
      "inputs": [
        "schema.prisma",
        "package.json"
      ]
    },
    "@gafus/web-vite#build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "src/**",
        "!dist/**",
        "public/**",
        "index.html",
        "vite.config.*",
        "tsconfig*.json",
        "package.json",
        "$TURBO_ROOT$/scripts/observability/postbuild-vite-maps.mjs",
        "$TURBO_ROOT$/scripts/observability/seal-vite-sourcemaps.mjs",
        "$TURBO_ROOT$/apps/admin-panel/src/admin-live/**",
        "$TURBO_ROOT$/scripts/refactor/dev-api-config.mjs"
      ],
      "env": [
        "VITE_*"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "@gafus/admin-panel#build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "src/**",
        "!dist/**",
        "public/**",
        "index.html",
        "vite.config.*",
        "tsconfig*.json",
        "package.json",
        "$TURBO_ROOT$/scripts/observability/postbuild-vite-maps.mjs",
        "$TURBO_ROOT$/scripts/observability/seal-vite-sourcemaps.mjs"
      ],
      "env": [
        "VITE_*"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "@gafus/trainer-panel#build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "src/**",
        "!src/trainer-vite/live/dist/**",
        "public/**",
        "index.html",
        "vite.config.*",
        "tsconfig*.json",
        "package.json",
        "$TURBO_ROOT$/scripts/observability/postbuild-vite-maps.mjs",
        "$TURBO_ROOT$/scripts/observability/seal-vite-sourcemaps.mjs"
      ],
      "env": [
        "VITE_*"
      ],
      "outputs": [
        "src/trainer-vite/live/dist/**"
      ]
    }
  }
}
