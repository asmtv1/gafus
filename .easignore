apps/trainer-panel/src/trainer-vite/preview/dist/

# From docs/archive/agents/.gitignore (scoped to its directory)
docs/archive/agents/apps/

# From infra/feed/.gitignore (scoped to its directory)
infra/feed/.terraform/
infra/feed/.secrets/
infra/feed/**/*.tfvars
!infra/feed/**/example.tfvars
infra/feed/**/*.tfplan
infra/feed/**/*.tfstate*

# From infra/gallery/.gitignore (scoped to its directory)
infra/gallery/.terraform/
infra/gallery/**/*.tfstate*
infra/gallery/**/*.tfplan
infra/gallery/**/*.tfvars
!infra/gallery/**/example.tfvars
infra/gallery/.secrets/
infra/gallery/**/crash.log

# From packages/gallery-storage/.gitignore (scoped to its directory)
packages/gallery-storage/dist/
packages/gallery-storage/.types/

# From packages/queues/.gitignore (scoped to its directory)
# tsc не должен коммитить артефакты в src (ломает Next/webpack)
packages/queues/src/**/*.js
packages/queues/src/**/*.d.ts
packages/queues/src/**/*.js.map
packages/queues/src/**/*.d.ts.map

# From scripts/refactor/local-development-data-inbox/.gitignore (scoped to its directory)
scripts/refactor/local-development-data-inbox/**/*
!scripts/refactor/local-development-data-inbox/**/.gitignore

# Only public certificate and admin-issued metadata, not signing credentials.
!apps/mobile/.ota-certs/
apps/mobile/.ota-certs/*
!apps/mobile/.ota-certs/native.pem
!apps/mobile/.ota-certs/ios-store-native.json
