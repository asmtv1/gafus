apps/mobile/**/.env
apps/mobile/**/.env.local
apps/mobile/**/.env.*.local
# TypeScript
apps/mobile/**/*.tsbuildinfo
# Testing
apps/mobile/coverage/
# EAS
apps/mobile/.eas/
