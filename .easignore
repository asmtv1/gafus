apps/mobile/.ota-certs/

# From apps/trainer-panel/.gitignore (scoped to its directory)
apps/trainer-panel/**/node_modules
apps/trainer-panel/**/.env

# From apps/trainer-panel/src/trainer-vite/preview/.gitignore (scoped to its directory)
