+
+    Function("setVerifiedDogWalkWidgetOwner") { (ownerId: String?) in
+      guard let defaults = UserDefaults(suiteName: "group.ru.gafus.app") else { return }
+      if let ownerId = ownerId, !ownerId.isEmpty {
+        defaults.set(ownerId, forKey: "gafus.walk-widget.verified-owner")
+      } else {
+        defaults.removeObject(forKey: "gafus.walk-widget.verified-owner")
+      }
+    }
+
+    Function("pendingDogWalkCommands") { () -> [[String: Any]] in
+      guard let root = FileManager.default.containerURL(forSecurityApplicationGroupIdentifier: "group.ru.gafus.app") else { return [] }
+      let folder = root.appendingPathComponent("walk-widget-commands-v1", isDirectory: true)
+      let files = (try? FileManager.default.contentsOfDirectory(at: folder, includingPropertiesForKeys: nil)) ?? []
+      let commands: [[String: Any]] = files.compactMap { url in
+        guard url.pathExtension == "json", let data = try? Data(contentsOf: url) else { return nil }
+        return (try? JSONSerialization.jsonObject(with: data)) as? [String: Any]
+      }
+      return commands.sorted { ($0["timestamp"] as? Int ?? 0) < ($1["timestamp"] as? Int ?? 0) }
+    }
+
+    Function("ackDogWalkCommand") { (commandId: String) in
+      guard UUID(uuidString: commandId) != nil,
+        let root = FileManager.default.containerURL(forSecurityApplicationGroupIdentifier: "group.ru.gafus.app") else { return }
+      let folder = root.appendingPathComponent("walk-widget-commands-v1", isDirectory: true)
+      try? FileManager.default.removeItem(at: folder.appendingPathComponent("\(commandId).json"))
