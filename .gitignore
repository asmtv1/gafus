# Dependencies
node_modules
.pnpm-store

# Lock files (используем только pnpm)
package-lock.json
yarn.lock
npm-shrinkwrap.json

# Локальные данные контейнеров (ClickHouse и т.п.)
docker-data/

# PostHog hobby runtime (клон + compose, см. docker/posthog/README.md)
docker/posthog/runtime/

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# GitHub tokens and secrets
ci-cd/configs/github-token.env

# Build outputs
dist
build
.next
out
# Скомпилированные артефакты в core/src (Next.js использует только .ts из src)
packages/core/src/**/*.js
packages/core/src/**/*.d.ts
!packages/core/src/petrovich.d.ts
packages/core/src/**/*.js.map
packages/core/src/**/*.d.ts.map
# types: сборка через tsup в dist/, в src только .ts
packages/types/src/**/*.js
packages/types/src/**/*.d.ts
packages/types/src/**/*.js.map
packages/types/src/**/*.d.ts.map

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Coverage directory used by tools like istanbul
coverage
*.lcov

# nyc test coverage
.nyc_output

# Dependency directories
jspm_packages/

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Microbundle cache
.rpt2_cache/
.rts2_cache_cjs/
.rts2_cache_es/
.rts2_cache_umd/

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# parcel-bundler cache (https://parceljs.org/)
.cache
.parcel-cache

# Next.js build output
.next

# Nuxt.js build / generate output
.nuxt

# Storybook build outputs
.out
.storybook-out

# Temporary folders
tmp/
temp/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.cursor/
.agents/
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Turbo
.turbo

# TypeScript

# SSL Certificates
certbot/
*.pem
*.key
*.crt
*.tsbuildinfo
tsconfig.tsbuildinfo
# Next.js cache
.next/cache/
.next/cache/**/*

# Uploads directory (files are stored in CDN)
packages/public-assets/public/uploads/

# Expo prebuild (CNG) — android/ios генерируются при сборке
apps/mobile/android
apps/mobile/ios

# EAS credentials и подписи (секреты)
apps/mobile/credentials.json
apps/mobile/credentials/
apps/mobile/rustore-signing/

# Локальные артефакты мобильных сборок
apps/mobile/Gafus.app/
apps/mobile/build-*.tar.gz

# Local production Stream credentials
/.env.stream-chat-prod

# Local Playwright/QA artifacts (never ship screenshots, browser dumps or reports)
/.playwright-cli/
/output/navigation-more/
/output/playwright/gallery/

/output/playwright/feed/

# Local isolated Web verification build: never commit generated Next.js artifacts
/apps/web/.next-cloudru-verify/

# Ephemeral production nginx maintenance lock
ci-cd/nginx/conf.d/.release-maintenance

# Local isolated Next.js verification builds
/apps/web/.next-*/

# Local Expo / Metro verification artifacts (never publish in release commits)
/.expo/
/apps/mobile/.build-validation-*/

# INFRA032 sensitive supplied raw PostgreSQL dump (never commit)
/gafus dump/

# Generated isolated QA and temporary Vite verification builds
**/.ag2-tmp/
**/.design-verify/
**/.*-build-2026*/
/apps/web-vite/.ag2-build-*/
/docs/refactor/agents/

# Pre-merge local-state and generated QA exclusions (2026-10-29)
/secrets/
*.p8
/.env.stream-chat-*
/.local-*/
/.ci-report/
/.ag[0-9]-*/
**/.ag[0-9]-*/
**/.g[0-9]-*/
**/.chat2-verify-*/
**/.chat2-avatar-verify-*/
**/.trainer-parity-check-*/
**/.notes-build-check-*/

# Historical isolated API contract/QA run captures; source remains in apps/api/src
/apps/api/g[0-9]*/
/apps/api/w1-*/
/apps/api/.g[0-9]*/
/apps/api/.guest-cleanup-private-build-*/

# Ephemeral test runner output, never source or release input.
**/*.stdout
**/*.stderr
**/*.exit

# IDE-generated code counting reports (not project sources)
/.VSCodeCounter/

# Local architecture QA workdirs (keep tracked root reports)
/.gafus-refactoring/*/
